---
// Inline sticker from public/images/stickers, e.g. <Sticker name="blue_cd.png" />.
// In raw markdown (blog posts) use <img class="sticker" src="..."> instead.
interface Props {
  name: string;
  alt?: string;
  size?: number;
}

const { name, alt = '', size } = Astro.props;
---

<img
  class="sticker"
  src={`/images/stickers/${name}`}
  alt={alt}
  loading="lazy"
  style={size ? `height: ${size}px;` : undefined}
/>
