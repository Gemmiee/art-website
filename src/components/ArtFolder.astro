---

import type { ArtFolderNode } from '../lib/artGallery';
import Sticker from './Sticker.astro';

interface Props {
  folder: ArtFolderNode;
  depth?: number;
}

const { folder, depth = 0 } = Astro.props;

const PAGE_SIZE = 30;

function countItems(node: ArtFolderNode): number {
  return node.items.length + node.subfolders.reduce((sum, sub) => sum + countItems(sub), 0);
}
const totalCount = countItems(folder);

const pages: (typeof folder.items)[] = [];
for (let i = 0; i < folder.items.length; i += PAGE_SIZE) {
  pages.push(folder.items.slice(i, i + PAGE_SIZE));
}

const stripExt = (name: string) => name.replace(/\.[^./]+$/, '');
---

<div class="art-folder" data-depth={depth}>
  <button
    class="art-folder-toggle"
    type="button"
    aria-expanded="false"
    aria-controls={`art-body-${folder.id}`}
  >
    {folder.thumbnailUrl ? (
      <img class="art-folder-icon-img" src={folder.thumbnailUrl} alt="" />
    ) : (
      <span class="art-folder-icon" aria-hidden="true">📁</span>
    )}
    <span class="art-folder-heading">
      <span class="art-folder-name">{folder.name}</span>
    </span>
    <span class="art-folder-count">{totalCount} {totalCount === 1 ? 'piece' : 'pieces'}</span>
    <span class="art-folder-chevron" aria-hidden="true">▸</span>
    {folder.description && <span class="art-folder-desc">{folder.description}</span>}
  </button>

  <div class="art-folder-body" id={`art-body-${folder.id}`} hidden>
    {folder.subfolders.map((sub) => (
      <Astro.self folder={sub} depth={depth + 1} />
    ))}

    {folder.items.length > 0 && (
      <div class="art-gallery">
        {pages.map((pageItems, pageIndex) => (
          <div class="art-gallery-page" data-page-index={pageIndex} hidden={pageIndex !== 0}>
            {pageItems.map((item) => (
              item.kind === 'image' ? (
                <button class="art-thumb" type="button" data-full={item.url} data-kind="image" data-name={stripExt(item.name)}>
                  <img src={item.thumbUrl ?? item.url} alt={stripExt(item.name)} loading="lazy" />
                </button>
              ) : (
                <button class="art-thumb art-thumb-video" type="button" data-full={item.url} data-kind="video" data-name={stripExt(item.name)}>
                  <!-- data-src not src: video preload isn't visibility-aware like
                       <img loading="lazy">, so it'd fetch even while collapsed.
                       Script swaps it to a real src when the folder opens. -->
                  <video data-src={item.url} poster={item.posterUrl} preload="none" muted playsinline></video>
                  <span class="art-thumb-play" aria-hidden="true">▶</span>
                </button>
              )
            ))}
          </div>
        ))}

        {pages.length > 1 && (
          <div class="art-pager" role="navigation" aria-label={`${folder.name} pages`}>
            {pages.map((_, pageIndex) => (
              <button
                class="art-pager-btn"
                type="button"
                data-page-index={pageIndex}
                aria-current={pageIndex === 0 ? 'page' : undefined}
              >
                {pageIndex + 1}
              </button>
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</div>
