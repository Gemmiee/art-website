---
interface Props {
  href: string;
  title: string;
  label: string;
  class?: string;
}

const { href, title, label, class: className } = Astro.props;
---

<a class:list={['rss-link', className]} href={href} title={title} aria-label={label}>
  <img src="/images/icons/rss.png" alt="" />
</a>

<style>
  .rss-link {
    display: inline-block;
    width: 22px;
    height: 22px;
  }
  /* inside a line of text the emoji is sized like the text around it :P */
  .rss-inline {
    width: 1.15em;
    height: 1.15em;
    margin-left: 4px;
    vertical-align: -0.2em;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 12.7%;
    box-shadow: 0 0 0 1px #9a4a0c;
  }
</style>
