---
const RING_HOME = 'https://dsring.neocities.org';
const RING_MEMBERS = 'https://dsring.neocities.org/members';
---

<div class="ds-ring" data-ds-ring>
  <img class="ds-img" src="/images/other_components/dsring_image.png" alt="DSring, a webring for DS fans" />

  <nav class="ds-screen-bottom" aria-label="DSring webring">
    <a class="ds-btn" data-ds-prev href={RING_HOME} aria-label="Previous site">&lt;</a>
    <a class="ds-btn ds-btn-home" href={RING_MEMBERS}>index</a>
    <a class="ds-btn" data-ds-next href={RING_HOME} aria-label="Next site">&gt;</a>
  </nav>
</div>

<script>
  const VARS_URL = 'https://dsring.neocities.org/dswidget/onionring-variables.js';
  const SELF = 'https://gemmiewow.com';

  let sitesPromise: Promise<string[]> | null = null;

  function loadSites(): Promise<string[]> {
    const w = window as any;
    if (Array.isArray(w.sites)) return Promise.resolve(w.sites);
    sitesPromise ??= new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = VARS_URL;
      s.onload = () => (Array.isArray(w.sites) ? resolve(w.sites) : reject(new Error('no sites')));
      s.onerror = reject;
      document.head.append(s);
    });
    return sitesPromise;
  }

  async function initDsRing() {
    const widget = document.querySelector<HTMLElement>('[data-ds-ring]');
    if (!widget) return;

    try {
      const sites = await loadSites();
      const clean = (u: string) => u.replace(/\/+$/, '');

      const i = sites.findIndex((s) => clean(s) === SELF);
      if (i === -1) throw new Error('not in ring');

      widget.querySelector<HTMLAnchorElement>('[data-ds-prev]')!.href = sites[(i - 1 + sites.length) % sites.length];
      widget.querySelector<HTMLAnchorElement>('[data-ds-next]')!.href = sites[(i + 1) % sites.length];
    } catch {
    }
  }

  document.addEventListener('astro:page-load', initDsRing);
</script>

<style>
  @font-face {
    font-family: 'NintendoDS';
    src: url('https://files.catbox.moe/24s612.ttf');
    font-display: swap;
  }

  .ds-ring {
    position: relative;
    width: 200px;
    max-width: 100%;
    font-family: 'NintendoDS', var(--font-ui, sans-serif);
  }
  .ds-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ds-screen-bottom {
    position: absolute;
    left: 28.1%;
    top: 58.4%;
    width: 43.6%;
    height: 32.3%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    box-sizing: border-box;
    container-type: size;
  }

  .ds-btn {
    width: 70%;
    padding: 0.15em 0;
    font-size: 18cqh;
    line-height: 1;
    text-align: center;
    color: #42637b;
    text-decoration: none;
    background: #fff;
    border: 1px solid #a5a5a5;
    border-radius: 3px;
  }
  .ds-btn:hover,
  .ds-btn:focus-visible {
    color: #0049cb;
    outline: none;
    border-color: #0049cb;
  }
</style>
