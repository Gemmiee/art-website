---
const RING_HOME = 'https://dsring.neocities.org';
const RING_MEMBERS = 'https://dsring.neocities.org/members';
---

<div class="ds-ring" data-ds-ring>
  <!-- top half -->
  <div class="ds-half ds-top">
    <span class="ds-speaker" aria-hidden="true"></span>
    <div class="ds-screen ds-screen-top">
      <div class="ds-titlebar">☶ DSring</div>
      <p class="ds-msg" data-ds-msg>a webring for DS fans</p>
    </div>
    <span class="ds-speaker" aria-hidden="true"></span>
  </div>

  <div class="ds-hinge" aria-hidden="true"></div>

  <!-- bottom half -->
  <div class="ds-half ds-bottom">
    <span class="ds-dpad" aria-hidden="true"></span>
    <nav class="ds-screen ds-screen-bottom" aria-label="DSring webring">
      <a class="ds-btn" data-ds-prev href={RING_HOME} aria-label="Previous site">◀</a>
      <a class="ds-btn ds-btn-home" href={RING_MEMBERS}>index</a>
      <a class="ds-btn" data-ds-next href={RING_HOME} aria-label="Next site">▶</a>
    </nav>
    <span class="ds-abxy" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  </div>
</div>

<script>
  const VARS_URL = 'https://dsring.neocities.org/dswidget/onionring-variables.js';
  const SELF = 'https://gemmiewow.com';

  let sitesPromise: Promise<string[]> | null = null;

  function loadSites(): Promise<string[]> {
    const w = window as any;
    if (Array.isArray(w.sites)) return Promise.resolve(w.sites);
    sitesPromise ??= new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = VARS_URL;
      s.onload = () => (Array.isArray(w.sites) ? resolve(w.sites) : reject(new Error('no sites')));
      s.onerror = reject;
      document.head.append(s);
    });
    return sitesPromise;
  }

  async function initDsRing() {
    const widget = document.querySelector<HTMLElement>('[data-ds-ring]');
    if (!widget) return;

    try {
      const sites = await loadSites();
      const clean = (u: string) => u.replace(/\/+$/, '');

      const i = sites.findIndex((s) => clean(s) === SELF);
      if (i === -1) throw new Error('not in ring');

      const prev = sites[(i - 1 + sites.length) % sites.length];
      const next = sites[(i + 1) % sites.length];
      widget.querySelector<HTMLAnchorElement>('[data-ds-prev]')!.href = prev;
      widget.querySelector<HTMLAnchorElement>('[data-ds-next]')!.href = next;
    } catch {
      // arrows already point at the ring's home page, which is a fine fallback
      const msg = widget.querySelector('[data-ds-msg]');
      if (msg) msg.textContent = 'ring offline... try the index!';
    }
  }

  document.addEventListener('astro:page-load', initDsRing);
</script>

<style>
  @font-face {
    font-family: 'NintendoDS';
    src: url('https://files.catbox.moe/24s612.ttf');
    font-display: swap;
  }

  .ds-ring {
    --ds-shell: #f4f4f6;
    --ds-shell-edge: #c9cad1;
    --ds-bezel: #2a2b30;
    --ds-screen: #ffffff;
    --ds-ink: #292929;
    --ds-link: #42637b;
    --ds-accent: #0049cb;

    width: 172px;
    font-family: 'NintendoDS', var(--font-ui, sans-serif);
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.18));
  }
  :global(:root[data-theme='dark']) .ds-ring {
    --ds-shell: #2c2d33;
    --ds-shell-edge: #15161a;
    --ds-bezel: #0d0d10;
    --ds-screen: #e9eef5;
  }

  .ds-half {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 6px;
    background: linear-gradient(180deg, var(--ds-shell), var(--ds-shell-edge) 180%);
    border: 1px solid var(--ds-shell-edge);
  }
  .ds-top {
    border-radius: 10px 10px 3px 3px;
  }
  .ds-bottom {
    border-radius: 3px 3px 12px 12px;
  }
  .ds-hinge {
    height: 5px;
    margin: 0 10px;
    background: var(--ds-shell-edge);
    border-radius: 0 0 3px 3px;
  }

  .ds-screen {
    width: 112px;
    height: 74px;
    background-color: var(--ds-screen);
    border: 4px solid var(--ds-bezel);
    border-radius: 2px;
    color: var(--ds-ink);
    overflow: hidden;
  }

  /* top screen */
  .ds-titlebar {
    padding: 2px 4px;
    font-size: 0.9rem;
    line-height: 1.2;
    background: url('https://dsring.neocities.org/universal/title.png') repeat-x;
    background-size: auto 100%;
    border-bottom: 2px solid var(--ds-bezel);
  }
  .ds-msg {
    margin: 0;
    padding: 6px 4px;
    font-size: 0.8rem;
    line-height: 1.15;
    text-align: center;
  }

  /* bottom screen */
  .ds-screen-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px;
    background-image: url('https://dsring.neocities.org/universal/grid-small.png');
    background-size: 31px;
  }
  .ds-btn {
    padding: 2px 4px;
    font-size: 0.85rem;
    color: var(--ds-link);
    text-decoration: none;
    background: var(--ds-screen);
    border: 2px solid #a5a5a5;
    border-radius: 3px;
  }
  .ds-btn:hover,
  .ds-btn:focus-visible {
    color: var(--ds-accent);
    outline: none;
    border: 2px solid transparent;
    border-image: url('https://dsring.neocities.org/universal/selection.png') 7% round;
  }

  /* little decorations */
  .ds-speaker {
    width: 8px;
    height: 22px;
    background: radial-gradient(circle, var(--ds-shell-edge) 1px, transparent 1.5px) 0 0 / 4px 4px;
  }
  .ds-dpad {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .ds-dpad::before,
  .ds-dpad::after {
    content: '';
    position: absolute;
    background: var(--ds-bezel);
    border-radius: 1px;
  }
  .ds-dpad::before {
    inset: 5px 0;
  }
  .ds-dpad::after {
    inset: 0 5px;
  }
  .ds-abxy {
    display: grid;
    grid-template-columns: repeat(3, 4px);
    grid-template-rows: repeat(3, 4px);
    gap: 1px;
  }
  .ds-abxy i {
    width: 4px;
    height: 4px;
    background: var(--ds-bezel);
    border-radius: 50%;
  }
  .ds-abxy i:nth-child(1) { grid-area: 1 / 2; }
  .ds-abxy i:nth-child(2) { grid-area: 2 / 1; }
  .ds-abxy i:nth-child(3) { grid-area: 2 / 3; }
  .ds-abxy i:nth-child(4) { grid-area: 3 / 2; }
</style>
