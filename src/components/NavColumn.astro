---
// Left sidebar: site navigation + the music player, present on every page.
import { musicAlbums } from '../data/musicAlbums';
import Sticker from './Sticker.astro';

const defaultAlbum = musicAlbums[0];

// Either `emoji` or `sticker` (a filename from public/images/stickers) works
// per link — sticker takes priority when both would somehow be set.
interface NavLink {
  label: string;
  href: string;
  emoji?: string;
  sticker?: string;
}

const topicsLinks: NavLink[] = [
  { sticker: 'yellow_sunflower.gif', label: 'Main Page', href: '/' },
  { sticker: 'white_letter.gif', label: 'Blog', href: '/blog' },
  { sticker: 'black_cd.gif', label: 'Music', href: '/music' },
  { sticker: 'blue_teddybear.gif', label: 'Guestbook', href: '/guestbook' },
];

const artLinks: NavLink[] = [
  { sticker: 'blue_cinnamonroll.gif', label: 'Art', href: '/art' },
  { sticker: 'blue_exclamations.gif', label: 'Commissions', href: '/art/commissions' },
];

interface GameLink {
  name: string;
  href: string;
  emoji?: string;
  sticker?: string;
}

const unlockedGames: GameLink[] = [
  { sticker: 'yellow_bee.gif', name: 'Space Cadet Pinball', href: '/pinball' },
  { sticker: 'yellow_pompompurin.gif', name: 'Spider Solitaire', href: '/spider-solitaire' },
  { sticker: 'blue_sea.gif', name: 'Paint', href: '/paint' },
  { sticker: 'blue_console.gif', name: 'Metal Slug X', href: '/metal-slug-x' },
];

// Grows over time as more standalone pages get added (Clipboard, Blinkies, etc.)
const otherLinks: NavLink[] = [
  { sticker: 'black_computer.gif', label: 'Links', href: '/links' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  return target === currentPath;
};

// On every page except the home page, the nav's banner sections (Topics,
// Games, Contact) start collapsed so the sidebar takes up less room.
const startExpanded = currentPath === '/';
---

<div class="col-nav">
  <!-- ================= mascot + mood check (FOR DESKTOP) ================= -->
  <div class="nav-mascot in-nav">
    <div class="nav-mascot-cloud">
      <img class="nav-mascot-cloud-img" src="/images/banners/speech_cloud_inverted.png" alt="" aria-hidden="true" />
      <img class="nav-mascot-cloud-img-night" src="/images/banners/speech_cloud_inverted_night.png" alt="" aria-hidden="true" />
      <div class="nav-mascot-mood">
        <p class="nav-mascot-mood-label">Mood Check:</p>
        <p class="nav-mascot-mood-note">University starting again... 😬</p>
      </div>
    </div>
    <img class="nav-mascot-sprite" src="/images/Gemmie_pixel.gif" alt="pixel Gemmie" />
  </div>

  <!-- ================= navigation ================= -->
  <section class="window compact inactive">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true"><Sticker name="black_cursor.gif" /></span>
      <span class="title-bar-text">topics.exe</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body">

      <div class="nav-section">
        <button class="nav-section-toggle" type="button" aria-expanded={startExpanded ? 'true' : 'false'} aria-controls="nav-sec-topics">
          <img class="nav-banner-img" src="/images/banners/banner_nav_topics.webp" alt="Topics" />
        </button>
        <ul class:list={['nav-list', 'nav-section-content', !startExpanded && 'is-collapsed']} id="nav-sec-topics">
          {topicsLinks.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.sticker ? <Sticker name={item.sticker} /> : <span aria-hidden="true">{item.emoji}</span>} {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="nav-section">
        <button class="nav-section-toggle" type="button" aria-expanded={startExpanded ? 'true' : 'false'} aria-controls="nav-sec-art">
          <img class="nav-banner-img" src="/images/banners/banner_nav_art.webp" alt="Art" />
        </button>
        <ul class:list={['nav-list', 'nav-section-content', !startExpanded && 'is-collapsed']} id="nav-sec-art">
          {artLinks.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.sticker ? <Sticker name={item.sticker} /> : <span aria-hidden="true">{item.emoji}</span>} {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="nav-section">
        <button class="nav-section-toggle" type="button" aria-expanded={startExpanded ? 'true' : 'false'} aria-controls="nav-sec-games">
          <img class="nav-banner-img" src="/images/banners/banner_nav_games.webp" alt="Games" />
        </button>
        <div class:list={['games-grid', 'nav-section-content', !startExpanded && 'is-collapsed']} id="nav-sec-games">
          {unlockedGames.map((game) => (
            <a
              class="game-slot game-slot-active"
              href={game.href}
              aria-current={isCurrent(game.href) ? 'page' : undefined}
            >
              {game.sticker ? <Sticker name={game.sticker} /> : <span class="game-slot-icon" aria-hidden="true">{game.emoji}</span>}
              <span class="game-slot-name">{game.name}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="nav-section">
        <button class="nav-section-toggle" type="button" aria-expanded={startExpanded ? 'true' : 'false'} aria-controls="nav-sec-other">
          <img class="nav-banner-img" src="/images/banners/banner_nav_other.webp" alt="Other" />
        </button>
        <ul class:list={['nav-list', 'nav-section-content', !startExpanded && 'is-collapsed']} id="nav-sec-other">
          {otherLinks.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.sticker ? <Sticker name={item.sticker} /> : <span aria-hidden="true">{item.emoji}</span>} {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= now playing ================= -->
  <section class="window compact inactive" id="now-playing">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true"><Sticker name="black_cd.gif" /></span>
      <span class="title-bar-text">nowplaying.mp3</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body bandcamp-body" id="now-playing-widget">
      <a class="now-playing-change-link" href="/music"><Sticker name="blue_cd.png" /> Change the music here!</a>
      <img
        class="bandcamp-cover"
        id="now-playing-cover"
        src={defaultAlbum.coverUrl}
        alt={`${defaultAlbum.title} album cover`}
        loading="lazy"
      />
      <p class="now-playing-label" id="now-playing-label">{defaultAlbum.title} — {defaultAlbum.artist}</p>
      <!-- This is a placeholder, not the real player: a live iframe reloads
           the instant a browser detaches + reattaches it, which is exactly
           what Astro's page-swap does to everything on the page (including
           transition:persist'ed elements — proven by testing, not assumed).
           The actual iframe is created once by client JS and lives directly
           on document.body, completely outside anything Astro re-renders or
           swaps, then visually pinned on top of this slot's position — so it
           never gets detached, and playback survives every navigation. -->
      <div class="bandcamp-frame bandcamp-frame-slot" id="now-playing-iframe-slot" aria-hidden="true"></div>
    </div>
  </section>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    // Main page always shows every section expanded (see startExpanded in
    // the frontmatter) regardless of what's remembered below — this just
    // has to match that same "is it home" check so the two never disagree.
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    const isHome = path === '/';

    const setSection = (btn: HTMLButtonElement, expanded: boolean) => {
      btn.setAttribute('aria-expanded', String(expanded));
      const content = document.getElementById(btn.getAttribute('aria-controls') || '');
      content?.classList.toggle('is-collapsed', !expanded);
    };

    document.querySelectorAll<HTMLButtonElement>('.nav-section-toggle').forEach((btn) => {
      const sectionId = btn.getAttribute('aria-controls') || '';
      const storageKey = `gemmie-nav-expanded:${sectionId}`;

      // Restore whatever was last chosen for this section on any OTHER
      // page — skipped on home, which always renders fully expanded
      // server-side already (startExpanded), so there's nothing to restore.
      if (!isHome) {
        try {
          const saved = localStorage.getItem(storageKey);
          if (saved !== null) {
            setSection(btn, saved === 'true');
          }
        } catch {}
      }

      btn.addEventListener('click', () => {
        const nowExpanded = btn.getAttribute('aria-expanded') !== 'true';
        setSection(btn, nowExpanded);
        // Saved even when clicked on home, so the choice is there waiting
        // the next time a non-home page loads.
        try {
          localStorage.setItem(storageKey, String(nowExpanded));
        } catch {}
      });
    });
  });
</script>

<script define:vars={{ musicAlbums }} is:inline>
  // The floating Bandcamp player: see the comment on #now-playing-iframe-slot
  // in the markup above for why this can't just be a normal iframe in the
  // page. This block runs after every navigation (astro:page-load fires on
  // hard loads AND every soft client-side nav) — the one-time setup (creating
  // the floating iframe, wiring the window listener) is guarded so it only
  // happens once per session, but repositioning + resyncing the visible
  // cover/label has to happen on every single nav, since the slot and the
  // cover/label elements are ordinary Astro-rendered nodes that get freshly
  // recreated (reset to the default album) on every page.
  document.addEventListener('astro:page-load', () => {
    const cover = document.getElementById('now-playing-cover');
    const label = document.getElementById('now-playing-label');
    if (!cover || !label) return;

    const bandcampEmbedSrc = (albumId) =>
      `https://bandcamp.com/EmbeddedPlayer/album=${albumId}/size=large/bgcol=faf3ea/linkcol=4b3a7a/tracklist=false/artwork=none/`;
    const findAlbum = (id) => musicAlbums.find((a) => a.id === id);
    // Re-queries the DOM every call rather than closing over cover/label —
    // the gemmie:play-album listener below is only ever attached once (see
    // the init guard further down), so its closure would otherwise keep
    // pointing at whatever page happened to be live at that first attach,
    // which is a stale, disconnected node on every later page.
    const renderInfo = (album) => {
      const coverEl = document.getElementById('now-playing-cover');
      const labelEl = document.getElementById('now-playing-label');
      if (coverEl) {
        coverEl.src = album.coverUrl;
        coverEl.alt = `${album.title} album cover`;
      }
      if (labelEl) {
        labelEl.textContent = `${album.title} — ${album.artist}`;
      }
    };

    if (!window.__gemmieFloatingFrame) {
      const frame = document.createElement('iframe');
      frame.id = 'now-playing-frame';
      frame.className = 'bandcamp-frame bandcamp-frame-floating';
      frame.setAttribute('seamless', '');
      // Appended to <html> itself, NOT document.body — Astro's page-swap
      // replaces the whole <body> element wholesale on every navigation (not
      // a fine-grained diff of its children), so anything living inside body
      // gets wiped along with it regardless of how it got there. A sibling
      // of <body> is untouched by that swap. position:fixed below doesn't
      // care about DOM ancestry, so this has no visual effect.
      document.documentElement.appendChild(frame);
      window.__gemmieFloatingFrame = frame;

      const syncPosition = () => {
        const slot = document.getElementById('now-playing-iframe-slot');
        if (!slot) {
          frame.style.display = 'none';
          return;
        }
        const rect = slot.getBoundingClientRect();
        const visible = rect.width > 0 && rect.height > 0;
        frame.style.display = visible ? 'block' : 'none';
        if (visible) {
          frame.style.top = `${rect.top}px`;
          frame.style.left = `${rect.left}px`;
          frame.style.width = `${rect.width}px`;
          frame.style.height = `${rect.height}px`;
        }
      };
      window.__gemmieSyncNowPlaying = syncPosition;

      window.addEventListener('scroll', syncPosition, { passive: true });
      window.addEventListener('resize', syncPosition);
      const navCol = document.querySelector('.col-nav');
      if (navCol) new ResizeObserver(syncPosition).observe(navCol);
    }

    const frame = window.__gemmieFloatingFrame;

    const setAlbum = (album, { persist = true } = {}) => {
      renderInfo(album);
      // Reassigning an iframe's src to the SAME url still restarts it in
      // some browsers, which would kill playback whenever this runs again —
      // this guard is what makes "do nothing when it's already playing"
      // possible. window.__gemmieCurrentAlbumId (not a DOM attribute) is the
      // source of truth here since the DOM nodes themselves get recreated
      // fresh by Astro on every navigation.
      if (window.__gemmieCurrentAlbumId === album.id) return;
      window.__gemmieCurrentAlbumId = album.id;
      frame.src = bandcampEmbedSrc(album.id);
      frame.title = `${album.title} by ${album.artist} — Bandcamp player`;
      if (persist) {
        try {
          localStorage.setItem('gemmie-now-playing-album', album.id);
        } catch {}
      }
    };

    if (!window.__gemmieNowPlayingInit) {
      window.__gemmieNowPlayingInit = true;
      let initialAlbum = musicAlbums[0];
      try {
        const savedId = localStorage.getItem('gemmie-now-playing-album');
        const saved = savedId && findAlbum(savedId);
        if (saved) initialAlbum = saved;
      } catch {}
      setAlbum(initialAlbum, { persist: false });

      window.addEventListener('gemmie:play-album', (e) => setAlbum(e.detail));
    } else {
      // Not the first load this session — the iframe is untouched and still
      // playing, but the cover/label are fresh nodes showing the default
      // album again, so resync them to whatever's actually still playing.
      const current = findAlbum(window.__gemmieCurrentAlbumId);
      if (current) renderInfo(current);
    }

    window.__gemmieSyncNowPlaying?.();
  });
</script>
