---
// Left sidebar: site navigation + the music player, present on every page.

const quickNav = [
  { emoji: '🙋', label: 'Main Page', href: '/' },
  { emoji: '🖼️', label: 'Art', href: '/art' },
  { emoji: '🔗', label: 'Links', href: '/links' },
];

const unlockedGames = [
  { icon: '🚀', name: 'Space Cadet Pinball', href: '/pinball' },
  { icon: '🕷️', name: 'Spider Solitaire', href: '/spider-solitaire' },
  { icon: '💣', name: 'Minesweeper', href: '/minesweeper' },
  { icon: '🎨', name: 'Paint', href: '/paint' },
];

const contactLinks = [
  { emoji: '📝', label: 'Guestbook', href: '/guestbook' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  return target === currentPath;
};
---

<div class="col-nav">
  <!-- ================= mascot + mood check (FOR DESKTOP) ================= -->
  <div class="nav-mascot in-nav">
    <div class="nav-mascot-cloud">
      <img class="nav-mascot-cloud-img" src="/images/banners/speech_cloud_inverted.png" alt="" aria-hidden="true" />
      <img class="nav-mascot-cloud-img-night" src="/images/banners/speech_cloud_inverted_night.png" alt="" aria-hidden="true" />
      <div class="nav-mascot-mood">
        <p class="nav-mascot-mood-label">Today's Mood:</p>
        <p class="nav-mascot-mood-note">Life's goood, waiting for my trip (＾▽＾)</p>
      </div>
    </div>
    <img class="nav-mascot-sprite" src="/images/Gemmie_pixel.gif" alt="pixel Gemmie" />
  </div>

  <!-- ================= navigation ================= -->
  <section class="window compact inactive">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true">📁</span>
      <span class="title-bar-text">topics.exe</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body">
      <img class="nav-banner-img" src="/images/banners/banner_topics.png" alt="Topics" />
      <ul class="nav-list">
        {quickNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              data-astro-reload={item.href === '/' ? true : undefined}
            >
              <span aria-hidden="true">{item.emoji}</span> {item.label}
            </a>
          </li>
        ))}
      </ul>

      <img class="nav-banner-img" id="games" src="/images/banners/banner_games.png" alt="Games" />
      <div class="games-grid">
        {unlockedGames.map((game) => (
          <a
            class="game-slot game-slot-active"
            href={game.href}
            aria-current={isCurrent(game.href) ? 'page' : undefined}
          >
            <span class="game-slot-icon">{game.icon}</span>
            <span class="game-slot-name">{game.name}</span>
          </a>
        ))}
      </div>

      <img class="nav-banner-img" src="/images/banners/banner_contact.png" alt="Contact" />
      <ul class="nav-list">
        {contactLinks.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span aria-hidden="true">{item.emoji}</span> {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= now playing ================= -->
  <section class="window compact inactive" id="now-playing">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true">♫</span>
      <span class="title-bar-text">nowplaying.mp3</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body bandcamp-body">
      <img
        class="bandcamp-cover"
        src="https://f4.bcbits.com/img/a3714087150_10.jpg"
        alt="Motorslice OST album cover"
        loading="lazy"
      />
      <iframe
        class="bandcamp-frame"
        title="Motorslice OST by Pizza Hotline — Bandcamp player"
        src="https://bandcamp.com/EmbeddedPlayer/album=44696348/size=large/bgcol=faf3ea/linkcol=4b3a7a/tracklist=false/artwork=none/"
        seamless
        loading="lazy"
      >
        Motorslice (Original Soundtrack) by Pizza Hotline, listen at pizzahotline.bandcamp.com/album/motorslice-ost
      </iframe>
    </div>
  </section>
</div>
