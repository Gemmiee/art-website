---
interface Props {
  class?: string;
}

const { class: extraClass = '' } = Astro.props;
---

<div class:list={['bubble-divider', extraClass]} role="separator" aria-hidden="true"></div>

<style>
  .bubble-divider {
    height: 6px;
    margin: 26px 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #9fe0ea 0%, #3f7fc9 55%, #1a3f66 100%);
    box-shadow: 0 1px 4px rgba(30, 25, 60, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.6);
  }
  .bubble-divider-dashed {
    height: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    border-top: 2px dashed var(--card-border-dashed);
  }
</style>
