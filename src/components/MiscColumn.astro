            </a>

            <a class="offsite-btn" href="https://yumi-is.online/" target="_blank" rel="noopener" aria-label="Yumi's Room">
              <img src="https://yumi-is.online/Assets/MyWebsiteButton.gif" alt="Yumi's Room" loading="lazy" />
            </a>

            <a class="offsite-btn" href="https://pawsablyamber.neocities.org/" target="_blank" rel="noopener" aria-label="pawsablyamber link">
              <img src="https://pawsablyamber.neocities.org/!index/images/amberbutton.png" alt="pawsablyamber button" loading="lazy" />
