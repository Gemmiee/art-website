          </a>
          <a class="friend-btn" href="https://www.youtube.com/channel/UCMr9ZRUKxJgv4uBKAtGeM0w" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_mia.gif" width="88" height="31" alt="" />
          </a>
          <a class="friend-btn" href="https://linktr.ee/sweetlysours" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_sweetly.png" width="88" height="31" alt="" />
