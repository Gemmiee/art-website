---
import BubbleDivider from './BubbleDivider.astro';
import Sticker from './Sticker.astro';

const socials = [
  { emoji: '🛍️', label: 'Ko-fi Shop', href: 'https://ko-fi.com/gemmiewow/', icon: 'icon_kofi.png' },
  { emoji: '🐠', label: 'Cara Art Portfolio', href: 'https://cara.app/gemmiewow', icon: 'icon_cara.png' },
  { emoji: '🪼', label: 'Pixelfed', href: 'https://pixelfed.social/gemmie_wow', icon: 'icon_pixelfed.png' },
  { emoji: '📸', label: 'Instagram', href: 'https://www.instagram.com/gemmie_wow', icon: 'icon_instagram.png' },
  { emoji: '🕹️', label: 'Twitch', href: 'https://www.twitch.tv/gemmie_wow', icon: 'icon_twitch.png' },
  { emoji: '🎥', label: 'YouTube', href: 'https://youtube.com/@gemmiewow', icon: 'icon_youtube.png' },
  { emoji: '🎨', label: "Colors!Live 3DS Gallery", href: 'https://www.colorslive.com/artist/GemmieWow', icon: 'icon_colorslive.png' },
  { emoji: '🎵', label: 'My Bandcamp Library', href: 'https://bandcamp.com/gemmiewow', icon: 'icon_bandcamp.png' },
];

const siteUrl = 'https://gemmiewow.com/';
const ownButtonSrc = `${siteUrl}images/friends/button_gem.gif`;
const embedCode = `<a href="${siteUrl}"><img src="${ownButtonSrc}" width="88" height="31" alt="Gemmie's corner"></a>`;
---

<div class="col-misc">
  <!-- ================= socials ================= -->
  <section class="window compact inactive" id="socials">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true"><img class="sticker" src="/images/stickers/blue_fish.gif" alt="" /></span>
      <span class="title-bar-text">socials.txt</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body">
      <div class="icon-link-grid">
        {socials.map((link) => (
          <a
            class="icon-link"
            href={link.href}
            target="_blank"
            rel="noopener"
            aria-label={link.label}
          >
            {link.icon ? (
              <img src={`/images/icons/${link.icon}`} alt="" />
            ) : (
              <span class="icon-link-emoji" aria-hidden="true">{link.emoji}</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- =============== friend links / webring ================ -->
  <section class="window compact inactive" id="friend-links">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true"><Sticker name="yellow_egg.png" /></span>
      <span class="title-bar-text">friends.htm</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body">
      <p class="hand-note">Cool as heck people</p>
      <div class="friend-marquee">
        <div class="friend-marquee-track">
          <a class="friend-btn" href="https://www.instagram.com/mage.236" target="_blank" rel="noopener">
            <img src="/images/friends/button_mage.png" width="88" height="31" alt="Mage" />
          </a>
          <a class="friend-btn" href="https://www.instagram.com/athinaleli/" target="_blank" rel="noopener">
            <img src="/images/friends/button_leli.png" width="88" height="31" alt="Leli" />
          </a>
          <a class="friend-btn" href="https://www.youtube.com/channel/UCMr9ZRUKxJgv4uBKAtGeM0w" target="_blank" rel="noopener">
            <img src="/images/friends/button_mia.gif" width="88" height="31" alt="mianimator" />
          </a>
          <a class="friend-btn" href="https://linktr.ee/sweetlysours" target="_blank" rel="noopener">
            <img src="/images/friends/button_sweetly.png" width="88" height="31" alt="Sweetly" />
          </a>
          <a class="friend-btn" href="https://www.instagram.com/kaito_solos_" target="_blank" rel="noopener">
            <img src="/images/friends/button_leda.png" width="88" height="31" alt="Leda" />
          </a>
          <a class="friend-btn" href="https://grasshampoo.carrd.co/" target="_blank" rel="noopener">
            <img src="/images/friends/button_grassy.png" width="88" height="31" alt="Grassy" />
          </a>
          <a class="friend-btn" href="https://www.instagram.com/voiceofthederanged" target="_blank" rel="noopener">
            <img src="/images/friends/button_dera.gif" width="88" height="31" alt="Dera" />
          </a>
          <a class="friend-btn" href="https://klaxxium.carrd.co/" target="_blank" rel="noopener">
            <img src="/images/friends/button_klax.gif" width="88" height="31" alt="Klaxxium" />
          </a>

          <!-- friend loop -->
          <a class="friend-btn" href="https://www.instagram.com/mage.236" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_mage.png" width="88" height="31" alt="" />
          </a>
          <a class="friend-btn" href="https://www.instagram.com/athinaleli/" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_leli.png" width="88" height="31" alt="" />
          </a>
          <a class="friend-btn" href="https://www.youtube.com/channel/UCMr9ZRUKxJgv4uBKAtGeM0w" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_mia.gif" width="88" height="31" alt="" />
          </a>
          <a class="friend-btn" href="https://linktr.ee/sweetlysours" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_sweetly.png" width="88" height="31" alt="" />
          </a>
          <a class="friend-btn" href="https://www.instagram.com/kaito_solos_" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_leda.png" width="88" height="31" alt="" />
          </a>
          <a class="friend-btn" href="https://grasshampoo.carrd.co/" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_grassy.png" width="88" height="31" alt="" />
          </a>
          <a class="friend-btn" href="https://www.instagram.com/voiceofthederanged" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_dera.gif" width="88" height="31" alt="" />
          </a>
          <a class="friend-btn" href="https://klaxxium.carrd.co/" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_klax.gif" width="88" height="31" alt="" />
          </a>
        </div>
      </div>

      <BubbleDivider class="bubble-divider-dashed" />

      <p class="hand-note">grab my button!</p>
      <a class="friend-btn" href={siteUrl} target="_blank" rel="noopener">
        <img src="/images/friends/button_gem.gif" width="88" height="31" alt="Gemmie's corner" />
      </a>
      <div class="embed-row">
        <input class="embed-input" type="text" readonly value={embedCode} />
        <button class="embed-copy-btn" type="button" data-copy-text={embedCode}>Copy</button>
      </div>
    </div>
  </section>

  <!-- ============== GUESTBOOK=============== -->
  <section class="window compact inactive" id="guestbook">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true"><Sticker name="yellow_pompompurin.gif" /></span>
      <span class="title-bar-text">guestbook.exe</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body">
      <p style="display: flex;" class="hand-note">
          Hosted by:
          <a style="margin-left:5px;" class="offsite-btn" href="https://atabook.org/" target="_blank" rel="noopener" aria-label="atabook website">
            <img src="https://atabook.org/images/button.gif" alt="atabook website button" loading="lazy" />
          </a>
      </p>
    </div>
    <div class="doc-section">
          <iframe src="https://gemmie.atabook.org/"
          class="guestbook-page-iframe"
          loading="lazy"></iframe>
     
    </div>
  </section>

  <!-- so the app bubbles are outside the socials window -->
  <div class="icon-tooltip" id="icon-tooltip" role="tooltip"></div>
</div>

<script>
  import { bindCopyButton } from '../lib/copyButton';

  // MiscColumn only renders on the home page
  document.addEventListener('astro:page-load', () => {
    const tooltip = document.getElementById('icon-tooltip');
    if (tooltip) {
      const hide = () => tooltip.classList.remove('is-visible');

      document.querySelectorAll<HTMLElement>('.icon-link').forEach((link) => {
        const label = link.getAttribute('aria-label') || '';
        const show = () => {
          const rect = link.getBoundingClientRect();
          tooltip.textContent = label;
          tooltip.style.left = `${rect.left + rect.width / 2}px`;
          tooltip.style.top = `${rect.top}px`;
          tooltip.classList.add('is-visible');
        };
        link.addEventListener('mouseenter', show);
        link.addEventListener('mouseleave', hide);
        link.addEventListener('focus', show);
        link.addEventListener('blur', hide);
      });

      window.addEventListener('blur', hide);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) hide();
      });
      window.addEventListener('scroll', hide, { passive: true });
    }

    // grab my button embed snippet
    const embedInput = document.querySelector<HTMLInputElement>('.embed-input');
    embedInput?.addEventListener('click', () => embedInput.select());
    bindCopyButton(document.querySelector<HTMLButtonElement>('.embed-copy-btn'), embedInput);
  });
</script>
