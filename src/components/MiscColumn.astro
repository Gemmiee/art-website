            <img src="/images/friends/button_dera.gif" width="88" height="31" alt="" />
          </a>
          <a class="friend-btn" href="https://klaxxium.carrd.co/" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            <img src="/images/friends/button_klax.gif" width="88" height="31" alt="" />
          </a>
        </div>
      </div>



      <div class="friend-marquee">
        <div class="friend-marquee-track">
          <a class="offsite-btn" href="https://petrapixel.neocities.org/" target="_blank" rel="noopener" aria-label="petrapixel website">
              <img src="https://cdn.jsdelivr.net/gh/petracoding/petrapixel.neocities.org@latest/public/assets/img/linkback.gif" alt="petrapixel button" loading="lazy" />
            </a>
            <a class="offsite-btn" href="https://zhongvie.neocities.org/" target="_blank" rel="noopener" aria-label="zhongvie button">
