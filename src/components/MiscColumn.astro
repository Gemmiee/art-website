---
// Right sidebar: socials, friend links, guestbook. Only rendered on pages
// that opt in via <PageShell showMisc> — secondary pages keep just nav + main.
import BubbleDivider from './BubbleDivider.astro';

const socials = [
  { emoji: '🛍️', label: 'Ko-fi Shop', href: 'https://ko-fi.com/gemmiewow/', icon: 'icon_kofi.png' },
  { emoji: '🐠', label: 'Cara Art Portfolio', href: 'https://cara.app/gemmiewow', icon: 'icon_cara.png' },
  { emoji: '🪼', label: 'Pixelfed', href: 'https://pixelfed.social/gemmie_wow', icon: 'icon_pixelfed.png' },
  { emoji: '📸', label: 'Instagram', href: 'https://www.instagram.com/gemmie_wow', icon: 'icon_instagram.png' },
  { emoji: '🕹️', label: 'Twitch', href: 'https://www.twitch.tv/gemmie_wow', icon: 'icon_twitch.png' },
  { emoji: '🎥', label: 'YouTube', href: 'https://youtube.com/@gemmiewow', icon: 'icon_youtube.png' },
  { emoji: '🎨', label: "Colors!Live 3DS Gallery", href: 'https://www.colorslive.com/artist/GemmieWow', icon: 'icon_colorslive.png' },
  { emoji: '🎵', label: 'My Bandcamp Library', href: 'https://bandcamp.com/gemmiewow', icon: 'icon_bandcamp.png' },
];

const friends = [
  { name: 'Mage', href: 'https://www.instagram.com/mage.236', button: 'button_mage.png' },
  { name: 'Leli', href: 'https://www.instagram.com/athinaleli/', button: 'button_leli.png' },
  { name: 'mianimator', href: 'https://www.youtube.com/channel/UCMr9ZRUKxJgv4uBKAtGeM0w', button: 'button_mia.gif' },
  { name: 'Sweetly', href: 'https://linktr.ee/sweetlysours', button: 'button_sweetly.png' },
  { name: 'Leda', href: 'https://www.instagram.com/kaito_solos_', button: 'button_leda.png' },
  { name: 'Grassy', href: 'https://grasshampoo.carrd.co/', button: 'button_grassy.png' },
  { name: 'Dera', href: 'https://www.instagram.com/voiceofthederanged', button: 'button_dera.gif' },
];

const siteUrl = 'https://gemmiewow.com/';
const ownButtonSrc = `${siteUrl}images/friends/button_gem.gif`;
const embedCode = `<a href="${siteUrl}"><img src="${ownButtonSrc}" width="88" height="31" alt="gemmie's corner"></a>`;
---

<div class="col-misc">
  <!-- ================= socials ================= -->
  <section class="window compact inactive" id="socials">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true">☆</span>
      <span class="title-bar-text">socials.txt</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body">
      <div class="icon-link-grid">
        {socials.map((link) => (
          <a
            class="icon-link"
            href={link.href}
            target="_blank"
            rel="noopener"
            aria-label={link.label}
          >
            {link.icon ? (
              <img src={`/images/icons/${link.icon}`} alt="" />
            ) : (
              <span class="icon-link-emoji" aria-hidden="true">{link.emoji}</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= friend links / webring ================= -->
  <section class="window compact inactive" id="friend-links">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true">🔗</span>
      <span class="title-bar-text">friend-links.htm</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body">
      <p class="hand-note">Cool as heck people</p>
      <div class="friend-grid">
        {friends.map((friend) => (
          <a class="friend-btn" href={friend.href} target="_blank" rel="noopener">
            <img src={`/images/friends/${friend.button}`} width="88" height="31" alt={friend.name} />
          </a>
        ))}
      </div>

      <BubbleDivider />

      <p class="hand-note">grab my button!</p>
      <a class="friend-btn" href={siteUrl} target="_blank" rel="noopener">
        <img src="/images/friends/button_gem.gif" width="88" height="31" alt="gemmie's corner" />
      </a>
      <div class="embed-row">
        <input class="embed-input" type="text" readonly value={embedCode} />
        <button class="embed-copy-btn" type="button" data-copy-text={embedCode}>Copy</button>
      </div>
    </div>
  </section>

  <!-- ================= guestbook ================= -->
  <section class="window compact inactive" id="guestbook">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true">📖</span>
      <span class="title-bar-text">chat.exe</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body">
      <!-- The chat box's own content was already sandboxed, but
           iframe.chat's loader script (below) used to run directly on
           THIS page with full, unsandboxed privileges — a <script> tag
           can't carry a sandbox attribute the way an iframe can, so that
           script (not the chat box itself) was the more likely source of
           a "malware popup blocked" warning some visitors saw. Wrapping
           the loader script AND the chat iframe together inside one
           sandboxed wrapper iframe (via srcdoc) sandboxes the script too,
           not just the widget it controls. Being a srcdoc'd iframe, this
           also loads fresh every time — no data-astro-rerun juggling
           needed the way a plain <script> tag required. -->
      <iframe
        class="guestbook-iframe"
        title="gemmie's corner guestbook chat"
        sandbox="allow-scripts allow-same-origin allow-forms allow-modals"
        srcdoc={`<!doctype html><html><head><style>html,body{margin:0;padding:0;height:100%;}</style></head><body>
<iframe id="chattable" src="https://iframe.chat/embed?chat=10281099" sandbox="allow-scripts allow-same-origin allow-forms allow-modals" style="display:block;width:100%;height:100%;border:0;"></iframe>
<script src="https://iframe.chat/scripts/main.min.js"></script>
<script>
  (function initChattable() {
    if (window.chattable && typeof window.chattable.initialize === 'function') {
      window.chattable.initialize({ stylesheet: "/chattable-kick.css" });
    } else {
      setTimeout(initChattable, 50);
    }
  })();
</script>
</body></html>`}
      ></iframe>
    </div>
  </section>

  <!-- so the app bubbles are outside the socials window -->
  <div class="icon-tooltip" id="icon-tooltip" role="tooltip"></div>
</div>

<script>
  // MiscColumn only renders on the home page
  document.addEventListener('astro:page-load', () => {
    const tooltip = document.getElementById('icon-tooltip');
    if (tooltip) {
      const hide = () => tooltip.classList.remove('is-visible');

      document.querySelectorAll<HTMLElement>('.icon-link').forEach((link) => {
        const label = link.getAttribute('aria-label') || '';
        const show = () => {
          const rect = link.getBoundingClientRect();
          tooltip.textContent = label;
          tooltip.style.left = `${rect.left + rect.width / 2}px`;
          tooltip.style.top = `${rect.top}px`;
          tooltip.classList.add('is-visible');
        };
        link.addEventListener('mouseenter', show);
        link.addEventListener('mouseleave', hide);
        link.addEventListener('focus', show);
        link.addEventListener('blur', hide);
      });

      window.addEventListener('blur', hide);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) hide();
      });
      window.addEventListener('scroll', hide, { passive: true });
    }

    // grab-my-button embed snippet
    const embedInput = document.querySelector<HTMLInputElement>('.embed-input');
    embedInput?.addEventListener('click', () => embedInput.select());

    const copyBtn = document.querySelector<HTMLButtonElement>('.embed-copy-btn');
    if (copyBtn) {
      const defaultLabel = copyBtn.textContent || 'Copy';
      copyBtn.addEventListener('click', async () => {
        const text = copyBtn.dataset.copyText || '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          embedInput?.select();
          document.execCommand('copy');
        }
        copyBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.textContent = defaultLabel;
        }, 1500);
      });
    }
  });
</script>
