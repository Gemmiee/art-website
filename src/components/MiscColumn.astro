              <img src="https://gusbus.space/assets/buttons/smallway.png" alt="smallweb subway ring button" loading="lazy" />
            </a>

          
           </div>
      </div>


      <BubbleDivider class="bubble-divider-dashed" />


      <p class="hand-note">grab my button!</p>
      <a class="friend-btn" href={siteUrl} target="_blank" rel="noopener">
        <img src="/images/friends/button_gem.gif" width="88" height="31" alt="Gemmie's corner" />
      </a>
      <div class="embed-row">
        <input class="embed-input" type="text" readonly value={embedCode} />
        <button class="embed-copy-btn" type="button" data-copy-text={embedCode}>Copy</button>
      </div>
    </div>
  </section>

  <!-- ------- guestbook --------- -->
  <section class="window compact inactive" id="guestbook">
    <div class="title-bar">
      <span class="title-bar-icon" aria-hidden="true"><Sticker name="yellow_pompompurin.gif" /></span>
      <span class="title-bar-text">guestbook.exe</span>
      <div class="title-bar-controls" aria-hidden="true">
        <span class="tb-btn">_</span>
        <span class="tb-btn">□</span>
        <span class="tb-btn close">×</span>
      </div>
    </div>
    <div class="window-body">
      <p style="display: flex;" class="hand-note">
          Hosted by:
          <a style="margin-left:5px;" class="offsite-btn" href="https://atabook.org/" target="_blank" rel="noopener" aria-label="atabook website">
            <img src="https://atabook.org/images/button.gif" alt="atabook website button" loading="lazy" />
          </a>
      </p>
    </div>
    <div class="doc-section">
          <iframe src="https://gemmie.atabook.org/"
          class="guestbook-page-iframe"
          loading="lazy"></iframe>
     
    </div>
  </section>

</div>

<script>
  import '../lib/widgetstar';
  import { bindCopyButton } from '../lib/copyButton';

  // MiscColumn only renders on the home page
  document.addEventListener('astro:page-load', () => {
    // grab my button
    const embedInput = document.querySelector<HTMLInputElement>('.embed-input');
    embedInput?.addEventListener('click', () => embedInput.select());
    bindCopyButton(document.querySelector<HTMLButtonElement>('.embed-copy-btn'), embedInput);
  });
</script>
