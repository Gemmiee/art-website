---
import NavColumn from './NavColumn.astro';
import MiscColumn from './MiscColumn.astro';

interface Props {
  showMisc?: boolean;
}

const { showMisc = true } = Astro.props;
---

<main class:list={['wrap', 'layout-grid', !showMisc && 'no-misc']}>
  <!-- ================= mood check (FOR MOBILE) =================
       Only visible on mobile, yes its a double mood check. The desktop one lives
       inside NavColumn.astro it's stuck-together with
       topics.exe as one. The mobile version of this looked ugly as heeell
       thus I changed it to be on top of gemmie-site. -->
  <div class="nav-mascot in-shell">
    <div class="nav-mascot-cloud">
      <img class="nav-mascot-cloud-img" src="/images/banners/speech_cloud_inverted.png" alt="" aria-hidden="true" />
      <img class="nav-mascot-cloud-img-night" src="/images/banners/speech_cloud_inverted_night.png" alt="" aria-hidden="true" />
      <div class="nav-mascot-mood">
        <p class="nav-mascot-mood-label">Today's Mood:</p>
        <p class="nav-mascot-mood-note">EXAM DONE! Now Italy trip!</p>
      </div>
    </div>
    <img class="nav-mascot-sprite" src="/images/Gemmie_pixel.gif" alt="pixel Gemmie" />
  </div>

  <div class="col-main">
    <slot />
  </div>

  <NavColumn />

  {showMisc && <MiscColumn />}

  <!-- ================= footer ================= -->
  <footer class="footer">
    <div class="badge-row">
      <span class="badge-btn">made w/ astro ☆</span>
      <span class="badge-btn">I do silly coding</span>
      
      <a href="https://frutigeraeroarchive.org/"><img src="https://frutigeraeroarchive.org/images/buttons/frutigeraeroarchive_button.png" alt="Frutiger Aero Archive"></a>
      <img src="https://i.postimg.cc/Qx9VPVqc/getphysicalbutton.gif" alt="Let's Get Physical"></img>

    </div>
    <p class="footer-note">☆ thanks for stopping by!!</p>
  </footer>
</main>
