---
import NavColumn from './NavColumn.astro';
import MiscColumn from './MiscColumn.astro';

interface Props {
  showMisc?: boolean;
}

const { showMisc = true } = Astro.props;
---

<main class:list={['wrap', 'layout-grid', !showMisc && 'no-misc']}>
  <!-- -------- MOOD CHECK FOR MOBILE ----------- -->
  <div class="nav-mascot in-shell">
    <div class="nav-mascot-cloud">
      <img class="nav-mascot-cloud-img" src="/images/banners/speech_cloud_inverted.png" alt="" aria-hidden="true" />
      <img class="nav-mascot-cloud-img-night" src="/images/banners/speech_cloud_inverted_night.png" alt="" aria-hidden="true" />
      <div class="nav-mascot-mood">
        <p class="nav-mascot-mood-label">Mood Check:</p>
        <p class="nav-mascot-mood-note">Yaarr mateys!</p>
      </div>
    </div>
    <img class="nav-mascot-sprite" src="/images/other_components/Gemmie_pixel.gif" alt="pixel Gemmie" />
  </div>

  <div class="col-main">
    <slot />
  </div>

  <NavColumn />

  {showMisc && <MiscColumn />}

  <!-- footer -->
  <footer class="footer">
    <div class="badge-row">
      <span class="badge-btn">made w/ Astro</span>
      <span class="badge-btn">I do silly art</span>
      
    
      <img src="/images/blinkies_stamps_tags/tags/tag_computer.gif" alt="I use a computer" width="88" height="31">
      <img src="/images/blinkies_stamps_tags/tags/tag_vscode.png" alt="VS Code" width="88" height="31">
      <img src="/images/blinkies_stamps_tags/tags/tag_mobile.png" alt="Mobile friendly" width="88" height="31">
    </div>
    <p class="footer-note">☆ Deployed on the web since 2026 ☆</p>
  </footer>
</main>
