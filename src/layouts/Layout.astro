---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Sticker from '../components/Sticker.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  feedUrl?: string;
}

const {
  title = "Gemmie's Aero Art Site",
  description = 'Art, animation, music, guestbook, games and more!',
  image = '/images/banner.webp',
  feedUrl,
} = Astro.props;

// Chat apps/social platforms unfurling a shared link need an absolute image
// URL — a root-relative one resolves against their own domain, not ours.
const ogImage = new URL(image, Astro.site).toString();
const ogUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {feedUrl && <link rel="alternate" type="application/rss+xml" title="Gemmie's corner — Blog" href={feedUrl} />}
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ViewTransitions />
  </head>
  <body>
    <div class="scene scene-light" aria-hidden="true"></div>
    <div class="scene scene-dark" aria-hidden="true"></div>

    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
      <span class="theme-icon sun-icon" aria-hidden="true"><Sticker name="black_cat.gif" /></span>
      <span class="theme-icon moon-icon" aria-hidden="true"><Sticker name="white_cat.gif" /></span>
    </button>

    <div class="site-banner">
      <img src="/images/banner2.webp" alt="Gemmie's corner banner — gemmiewow.com" />
    </div>

    <slot />

    <script>
      // ViewTransitions resets data-theme to "light" on every swap, so
      // reapply the saved theme after each one, not just on first load.
      function applyStoredTheme() {
        const stored = localStorage.getItem('theme');
        const theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      }
      document.addEventListener('astro:after-swap', applyStoredTheme);

      // Button is recreated on every swap (not persisted), so rebind the
      // click listener each time — astro:page-load fires on every nav,
      // unlike DOMContentLoaded which only fires once.
      document.addEventListener('astro:page-load', () => {
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
          themeToggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
          });
        }

        initBubbleCursor();
      });

      // Bubble cursor trail — adapted from a 2010-era mf2fm effect. Rewritten
      // to run once (guarded below) instead of recreating 66 divs on every
      // nav, and to live on <html> rather than <body> — Astro wipes and
      // rebuilds <body>'s contents on every page swap, which would silently
      // kill the effect (and leave the old div references dangling) after
      // the very first in-site link click.
      interface Bubble {
        style: CSSStyleDeclaration;
        x: number;
        y: number;
        size: number;
        falling: boolean;
      }

      function initBubbleCursor() {
        const win = window as typeof window & { __gemmieBubbleCursorInit?: boolean };
        if (win.__gemmieBubbleCursorInit) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        win.__gemmieBubbleCursorInit = true;

        const BUBBLE_COUNT = 66;
        const Z_INDEX = 1000;

        const bubbles: Bubble[] = [];
        for (let i = 0; i < BUBBLE_COUNT; i++) {
          const el = document.createElement('div');
          el.style.position = 'absolute';
          el.style.visibility = 'hidden';
          el.style.zIndex = String(Z_INDEX);
          el.style.borderRadius = '50%';
          // border split top/left vs bottom/right, like a light source from
          // the top-left — a simple stand-in for the original's 3-layered
          // bordered-div bevel trick, which predates reliable border-radius
          el.style.border = '1px solid #4b3a7a';
          el.style.borderTopColor = '#ab98e6';
          el.style.borderLeftColor = '#ab98e6';
          el.style.backgroundColor = '#e6ddf7';
          el.style.opacity = '0.6';
          document.documentElement.appendChild(el);
          bubbles.push({ style: el.style, x: 0, y: 0, size: 0, falling: false });
        }

        let cursorX = -9999;
        let cursorY = -9999;
        let lastX = cursorX;
        let lastY = cursorY;
        let viewW = window.innerWidth;
        let viewH = window.innerHeight;

        const spawnBubble = () => {
          const bubble = bubbles.find((b) => !b.falling);
          if (!bubble) return;
          bubble.x = cursorX;
          bubble.y = cursorY - 3;
          bubble.size = 3;
          bubble.falling = true;
          bubble.style.left = `${bubble.x}px`;
          bubble.style.top = `${bubble.y}px`;
          bubble.style.width = '3px';
          bubble.style.height = '3px';
          bubble.style.visibility = 'visible';
        };

        const updateBubble = (bubble: Bubble, index: number) => {
          bubble.y -= bubble.size / 2 + (index % 2);
          bubble.x += (index % 5 - 2) / 5;
          const inView =
            bubble.y > window.scrollY &&
            bubble.x > window.scrollX &&
            bubble.x < window.scrollX + viewW + bubble.size;
          if (!inView) {
            bubble.style.visibility = 'hidden';
            bubble.falling = false;
            return;
          }
          if (Math.random() < (bubble.size / viewH) * 2 && bubble.size++ < 8) {
            bubble.style.width = `${bubble.size}px`;
            bubble.style.height = `${bubble.size}px`;
          }
          bubble.style.top = `${bubble.y}px`;
          bubble.style.left = `${bubble.x}px`;
        };

        const tick = () => {
          if (Math.abs(cursorX - lastX) > 1 || Math.abs(cursorY - lastY) > 1) {
            lastX = cursorX;
            lastY = cursorY;
            spawnBubble();
          }
          bubbles.forEach((bubble, i) => {
            if (bubble.falling) updateBubble(bubble, i);
          });
          setTimeout(tick, 40);
        };
        tick();

        document.addEventListener('mousemove', (e) => {
          cursorX = e.pageX;
          cursorY = e.pageY;
        });

        // held-down mouse keeps spawning bubbles at a fixed "off-screen"
        // source point — same trick the original used for a click "splash"
        let splashTimer: ReturnType<typeof setTimeout>;
        const splash = () => {
          lastX = -1;
          lastY = -1;
          splashTimer = setTimeout(splash, 100);
        };
        document.addEventListener('mousedown', splash);
        document.addEventListener('mouseup', () => clearTimeout(splashTimer));

        window.addEventListener('resize', () => {
          viewW = window.innerWidth;
          viewH = window.innerHeight;
        });
      }

    </script>

    <style>
      /* Day/night scene: 6 stacked bg-images per element, listed back-to-front
         (sky -> sun/moon -> sea -> clouds -> field -> lampost). Scenes just
         crossfade via opacity, no independent sun/moon motion. */
      :root {
        /* mixed %/px nudge, tuned against the nav column's measured bounds,
           so the shift holds up across viewport ratios */
        --celestial-x: calc(5% - 260px);
        --celestial-y: 14%;
      }
      @media (max-width: 900px) {
        :root {
          --celestial-x: calc(20% - 40px);
        }
      }
      .scene {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        /* 100lvh (largest viewport) instead of plain height:100vh, so the
           mobile toolbar showing/hiding doesn't visibly rescale the bg. */
        height: 100vh;
        height: 100lvh;
        z-index: -3;
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center, center, center, center, var(--celestial-x) var(--celestial-y), center;
        pointer-events: none;
        transition: opacity 1.4s ease;
      }
      .scene-light {
        background-image:
          url('/images/wallpaper/light/light_lampost.webp'),
          url('/images/wallpaper/light/light_field.webp'),
          url('/images/wallpaper/light/light_clouds.webp'),
          url('/images/wallpaper/light/light_sea.webp'),
          url('/images/wallpaper/light/light_sun.webp'),
          url('/images/wallpaper/light/light_sky.webp');
        opacity: 1;
      }
      .scene-dark {
        background-image:
          url('/images/wallpaper/dark/dark_lampost.webp'),
          url('/images/wallpaper/dark/dark_field.webp'),
          url('/images/wallpaper/dark/dark_clouds.webp'),
          url('/images/wallpaper/dark/dark_sea.webp'),
          url('/images/wallpaper/dark/dark_moon.webp'),
          url('/images/wallpaper/dark/dark_sky.webp');
        opacity: 0;
      }
      :root[data-theme="dark"] .scene-light {
        opacity: 0;
      }
      :root[data-theme="dark"] .scene-dark {
        opacity: 1;
      }

      .site-banner {
        max-width: 1360px;
        margin: 0 auto;
        padding: 28px 16px 0;
        position: relative;
        z-index: 1;
      }
      .site-banner img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: var(--radius);
        border: 1px solid var(--glass-border);
        box-shadow: var(--shadow-window);
      }

      .theme-toggle {
        position: fixed;
        top: 16px;
        right: 16px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid var(--glass-border);
        background: var(--glass-fill-strong);
        backdrop-filter: blur(10px) saturate(1.4);
        -webkit-backdrop-filter: blur(10px) saturate(1.4);
        box-shadow: var(--shadow-soft);
        cursor: pointer;
        z-index: 50;
      }
      .theme-icon {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        transition: opacity 0.4s ease, transform 0.4s ease;
      }
      :root[data-theme="light"] .sun-icon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }
      :root[data-theme="light"] .moon-icon {
        opacity: 0;
        transform: rotate(-90deg) scale(0.6);
      }
      :root[data-theme="dark"] .sun-icon {
        opacity: 0;
        transform: rotate(90deg) scale(0.6);
      }
      :root[data-theme="dark"] .moon-icon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }
    </style>
    
  </body>
</html>
