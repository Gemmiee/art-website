---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "gemmie's corner ☆",
  description = 'Artist + animator studying programming. My little scrapbook corner of the internet.',
} = Astro.props;

const taskbarLinks = [
  { label: 'About', href: '#about' },
  { label: 'Art', href: '#art' },
  { label: 'OCs', href: '#ocs' },
  { label: 'Socials', href: '#socials' },
  { label: 'Guestbook', href: '#guestbook' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-banner">
      <img src="/images/banner.png" alt="Gemmie's corner banner — artist.gemmiewow.com" />
    </div>

    <slot />

    <nav class="taskbar" aria-label="Section navigation">
      <button class="start-orb" type="button" aria-label="Start">
        <span class="start-orb-glyph"></span>
      </button>
      <div class="taskbar-sep" aria-hidden="true"></div>
      <ul class="taskbar-items">
        {taskbarLinks.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="tray">
        <span class="tray-icon" aria-hidden="true">🔊</span>
        <span class="tray-icon" aria-hidden="true">📶</span>
        <span class="clock" id="taskbar-clock">--:--</span>
      </div>
    </nav>

    <script>
      const clockEl = document.getElementById('taskbar-clock');
      function tick() {
        if (!clockEl) return;
        const now = new Date();
        let h = now.getHours();
        const m = now.getMinutes().toString().padStart(2, '0');
        const ampm = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        clockEl.textContent = `${h}:${m} ${ampm}`;
      }
      tick();
      setInterval(tick, 15000);
    </script>

    <style>
      .site-banner {
        max-width: 1360px;
        margin: 0 auto;
        padding: 28px 16px 0;
        position: relative;
        z-index: 1;
      }
      .site-banner img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: var(--radius);
        border: 1px solid var(--glass-border);
        box-shadow: var(--shadow-window);
      }

      .taskbar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        height: var(--taskbar-height);
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 10px;
        background: linear-gradient(180deg, rgba(52, 38, 82, 0.55) 0%, var(--taskbar-glass) 60%, rgba(16, 10, 28, 0.88) 100%);
        border-top: 1px solid var(--taskbar-border);
        backdrop-filter: blur(14px) saturate(1.5);
        -webkit-backdrop-filter: blur(14px) saturate(1.5);
        z-index: 50;
      }

      .start-orb {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.5);
        background: radial-gradient(circle at 32% 28%, #ffcf94 0%, #e8823a 45%, #a85a1e 100%);
        box-shadow: 0 0 0 2px rgba(255,255,255,0.08), 0 3px 8px rgba(0,0,0,0.4), inset 0 2px 4px rgba(255,255,255,0.5);
        flex-shrink: 0;
        cursor: pointer;
        position: relative;
      }
      .start-orb-glyph {
        position: absolute;
        inset: 0;
        margin: auto;
        width: 12px;
        height: 12px;
        background:
          linear-gradient(#fff, #fff) 0 0 / 5px 5px no-repeat,
          linear-gradient(#fff, #fff) 7px 0 / 5px 5px no-repeat,
          linear-gradient(#fff, #fff) 0 7px / 5px 5px no-repeat,
          linear-gradient(#fff, #fff) 7px 7px / 5px 5px no-repeat;
        opacity: 0.92;
      }

      .taskbar-sep {
        width: 1px;
        align-self: stretch;
        margin: 8px 2px;
        background: rgba(255,255,255,0.2);
      }

      .taskbar-items {
        list-style: none;
        display: flex;
        gap: 6px;
        margin: 0;
        padding: 0;
        flex: 1;
        overflow-x: auto;
      }
      .taskbar-items a {
        display: block;
        white-space: nowrap;
        color: var(--ink-inverse);
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 8px 12px;
        border-radius: 4px;
        border: 1px solid transparent;
        background: rgba(255,255,255,0.06);
      }
      .taskbar-items a:hover {
        background: rgba(255,255,255,0.18);
        border-color: rgba(255,255,255,0.3);
      }

      .tray {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--ink-inverse);
        font-size: 0.82rem;
        padding: 0 4px;
        flex-shrink: 0;
      }
      .tray-icon {
        font-size: 0.9rem;
        opacity: 0.9;
      }
      .clock {
        font-variant-numeric: tabular-nums;
        min-width: 68px;
        text-align: center;
      }

      @media (max-width: 560px) {
        .taskbar-items li:nth-child(n+4) {
          display: none;
        }
        .tray-icon {
          display: none;
        }
      }
    </style>
  </body>
</html>
