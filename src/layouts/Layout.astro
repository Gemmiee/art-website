---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Sticker from '../components/Sticker.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  feedUrl?: string;
}

const {
  title = "Gemmie's Aero Art Site",
  description = 'Art, animation, music, guestbook, games and more!',
  image = '/images/banner.webp',
  feedUrl,
} = Astro.props;

// Chat apps/social platforms unfurling a shared link need an absolute image
// URL — a root-relative one resolves against their own domain, not ours.
const ogImage = new URL(image, Astro.site).toString();
const ogUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {feedUrl && <link rel="alternate" type="application/rss+xml" title="Gemmie's corner — Blog" href={feedUrl} />}
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ViewTransitions />
  </head>
  <body>
    <div class="scene scene-light" aria-hidden="true"></div>
    <div class="scene scene-dark" aria-hidden="true"></div>

    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
      <span class="theme-icon sun-icon" aria-hidden="true"><Sticker name="black_cat.gif" /></span>
      <span class="theme-icon moon-icon" aria-hidden="true"><Sticker name="white_cat.gif" /></span>
    </button>

    <div class="site-banner">
      <img src="/images/banner2.webp" alt="Gemmie's corner banner — gemmiewow.com" />
    </div>

    <slot />

    <script>
      // Every client-side page swap (from enabling ViewTransitions so the
      // music player can survive navigation) resets <html>'s attributes
      // back to the new page's raw markup — data-theme="light" — so the
      // stored theme has to be reapplied right after each swap, not just
      // on the very first hard load.
      function applyStoredTheme() {
        const stored = localStorage.getItem('theme');
        const theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      }
      document.addEventListener('astro:after-swap', applyStoredTheme);

      // The toggle button itself is recreated fresh on every page swap
      // (it isn't transition:persist'ed), so its click listener has to be
      // reattached every time too — astro:page-load fires after both the
      // first load and every subsequent navigation, unlike DOMContentLoaded
      // which only ever fires once per browser session.
      document.addEventListener('astro:page-load', () => {
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
          themeToggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
          });
        }
      });
    </script>

    <style>
      /* ---------- layered day/night scene ----------
         each scene is one element with 6 stacked background-images.
         CSS layers the FIRST-listed image on top, so the list is
         written back-to-front in reverse of the visual stacking:
         sky -> sun/moon -> sea -> clouds -> field -> lampost (front).
         The sun/moon layer sits at a fixed position (nudged left/off-
         center so it clears the left nav column) and the two scenes
         simply crossfade via opacity — no independent sink/rise motion. */
      :root {
        /* mixed %/px nudge (not a plain %) so the shift is consistent
           regardless of viewport aspect ratio / cover-crop amount —
           tuned against the left nav column's actual measured bounds */
        --celestial-x: calc(5% - 260px);
        --celestial-y: 14%;
      }
      @media (max-width: 900px) {
        :root {
          --celestial-x: calc(20% - 40px);
        }
      }
      .scene {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        /* On mobile, the address bar/toolbar showing or hiding shrinks and
           grows the viewport — `inset: 0` (i.e. height: 100vh) would resize
           with it, visibly rescaling this cover-fit background on every
           toggle. Sizing to the *largest* possible viewport instead keeps
           the image itself perfectly still; only how much of it the
           toolbar currently covers changes, which reads as static. */
        height: 100vh;
        height: 100lvh;
        z-index: -3;
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center, center, center, center, var(--celestial-x) var(--celestial-y), center;
        pointer-events: none;
        transition: opacity 1.4s ease;
      }
      .scene-light {
        background-image:
          url('/images/wallpaper/light/light_lampost.webp'),
          url('/images/wallpaper/light/light_field.webp'),
          url('/images/wallpaper/light/light_clouds.webp'),
          url('/images/wallpaper/light/light_sea.webp'),
          url('/images/wallpaper/light/light_sun.webp'),
          url('/images/wallpaper/light/light_sky.webp');
        opacity: 1;
      }
      .scene-dark {
        background-image:
          url('/images/wallpaper/dark/dark_lampost.webp'),
          url('/images/wallpaper/dark/dark_field.webp'),
          url('/images/wallpaper/dark/dark_clouds.webp'),
          url('/images/wallpaper/dark/dark_sea.webp'),
          url('/images/wallpaper/dark/dark_moon.webp'),
          url('/images/wallpaper/dark/dark_sky.webp');
        opacity: 0;
      }
      :root[data-theme="dark"] .scene-light {
        opacity: 0;
      }
      :root[data-theme="dark"] .scene-dark {
        opacity: 1;
      }

      .site-banner {
        max-width: 1360px;
        margin: 0 auto;
        padding: 28px 16px 0;
        position: relative;
        z-index: 1;
      }
      .site-banner img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: var(--radius);
        border: 1px solid var(--glass-border);
        box-shadow: var(--shadow-window);
      }

      .theme-toggle {
        position: fixed;
        top: 16px;
        right: 16px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid var(--glass-border);
        background: var(--glass-fill-strong);
        backdrop-filter: blur(10px) saturate(1.4);
        -webkit-backdrop-filter: blur(10px) saturate(1.4);
        box-shadow: var(--shadow-soft);
        cursor: pointer;
        z-index: 50;
      }
      .theme-icon {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        transition: opacity 0.4s ease, transform 0.4s ease;
      }
      :root[data-theme="light"] .sun-icon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }
      :root[data-theme="light"] .moon-icon {
        opacity: 0;
        transform: rotate(-90deg) scale(0.6);
      }
      :root[data-theme="dark"] .sun-icon {
        opacity: 0;
        transform: rotate(90deg) scale(0.6);
      }
      :root[data-theme="dark"] .moon-icon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }
    </style>
    
  </body>
</html>
