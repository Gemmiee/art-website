---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Sticker from '../components/Sticker.astro';
import { musicAlbums } from '../data/musicAlbums';

const defaultAlbum = musicAlbums[0];

interface Props {
  title?: string;
  description?: string;
  image?: string;
  feedUrl?: string;
}

const {
  title = "Gemmie's Aero Art Site",
  description = 'Art, animation, music, guestbook, games and more!',
  image = '/images/other_components/banner.webp',
  feedUrl,
} = Astro.props;

const ogImage = new URL(image, Astro.site).toString();
const ogUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Sanrio webring styling -->
    <link href="https://luckyatoll.nekoweb.org/sanriowebring.css" rel="stylesheet" type="text/css" media="all" />
    {feedUrl && <link rel="alternate" type="application/rss+xml" title="Gemmie's corner — Blog" href={feedUrl} />}
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ViewTransitions />
  </head>
  <body>
    <div class="scene scene-light" aria-hidden="true"></div>
    <div class="scene scene-dark" aria-hidden="true"></div>

    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
      <span class="theme-icon sun-icon" aria-hidden="true"><Sticker name="black_cat.gif" /></span>
      <span class="theme-icon moon-icon" aria-hidden="true"><Sticker name="white_cat.gif" /></span>
    </button>

    <img class="corner-mascot" src="/images/other_components/gemmie_yaar_clique.gif" alt="" aria-hidden="true" />

    <div class="now-playing-widget" id="now-playing-widget">
      <section class="window compact inactive">
        <button
          class="now-playing-toggle"
          type="button"
          id="now-playing-toggle"
          aria-expanded="false"
          aria-controls="now-playing-content"
        >
          <div class="title-bar">
            <span class="title-bar-icon" aria-hidden="true"><Sticker name="black_cd.gif" /></span>
            <span class="title-bar-text">player.mp3</span>
          </div>
        </button>
        <div class="nav-section-content is-collapsed" id="now-playing-content">
          <div class="bandcamp-body">
            <img
              class="bandcamp-cover"
              id="now-playing-cover"
              src={defaultAlbum.coverUrl}
              alt={`${defaultAlbum.title} album cover`}
              loading="lazy"
            />
            <a class="now-playing-change-link" href="/music">Change the music here!</a>
            <div class="bandcamp-frame bandcamp-frame-slot" id="now-playing-iframe-slot" aria-hidden="true"></div>
          </div>
        </div>
      </section>
    </div>

    <div class="site-banner">
      <img src="/images/other_components/banner2.webp" alt="Gemmie's corner banner — gemmiewow.com" />
    </div>

    <slot />

    <script>
      // remembers theme
      function applyStoredTheme() {
        const stored = localStorage.getItem('theme');
        const theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      }
      document.addEventListener('astro:after-swap', applyStoredTheme);

      document.addEventListener('astro:page-load', () => {
        const themeToggle = document.getElementById('theme-toggle');
        if (themeToggle) {
          themeToggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
          });
        }
      });
    </script>

    <script define:vars={{ musicAlbums }} is:inline>
      // Floating Bandcamp player
      document.addEventListener('astro:page-load', () => {
        const slot = document.getElementById('now-playing-iframe-slot');
        if (!slot) return;

        const bandcampEmbedSrc = (albumId) =>
          `https://bandcamp.com/EmbeddedPlayer/album=${albumId}/size=large/bgcol=faf3ea/linkcol=4b3a7a/tracklist=true/artwork=none/transparent=true/`;
        const findAlbum = (id) => musicAlbums.find((a) => a.id === id);

        if (!window.__gemmieFloatingFrame) {
          const frame = document.createElement('iframe');
          frame.id = 'now-playing-frame';
          frame.className = 'bandcamp-frame bandcamp-frame-floating';
          frame.setAttribute('seamless', '');
          document.documentElement.appendChild(frame);
          window.__gemmieFloatingFrame = frame;

          const syncPosition = () => {
            const slot = document.getElementById('now-playing-iframe-slot');
            if (!slot) {
              frame.style.display = 'none';
              return;
            }

            const content = document.getElementById('now-playing-content');
            const collapsed = content ? content.getBoundingClientRect().height === 0 : false;
            const rect = slot.getBoundingClientRect();
            const visible = !collapsed && rect.width > 0 && rect.height > 0;
            frame.style.display = visible ? 'block' : 'none';
            if (visible) {
              frame.style.top = `${rect.top}px`;
              frame.style.left = `${rect.left}px`;
              frame.style.width = `${rect.width}px`;
              frame.style.height = `${rect.height}px`;
            }
          };
          window.__gemmieSyncNowPlaying = syncPosition;
          window.addEventListener('resize', syncPosition);
        }

        const frame = window.__gemmieFloatingFrame;

        const renderCover = (album) => {
          const coverEl = document.getElementById('now-playing-cover');
          if (coverEl) {
            coverEl.src = album.coverUrl;
            coverEl.alt = `${album.title} album cover`;
          }
        };

        const setAlbum = (album, { persist = true } = {}) => {
          renderCover(album);
          if (window.__gemmieCurrentAlbumId === album.id) return;
          window.__gemmieCurrentAlbumId = album.id;
          frame.src = bandcampEmbedSrc(album.id);
          frame.title = `${album.title} by ${album.artist} — Bandcamp player`;
          if (persist) {
            try {
              localStorage.setItem('gemmie-now-playing-album', album.id);
            } catch {}
          }
        };

        if (!window.__gemmieNowPlayingInit) {
          window.__gemmieNowPlayingInit = true;
          let initialAlbum = musicAlbums[0];
          try {
            const savedId = localStorage.getItem('gemmie-now-playing-album');
            const saved = savedId && findAlbum(savedId);
            if (saved) initialAlbum = saved;
          } catch {}
          setAlbum(initialAlbum, { persist: false });

          window.addEventListener('gemmie:play-album', (e) => setAlbum(e.detail));
        } else {
          const current = findAlbum(window.__gemmieCurrentAlbumId);
          if (current) renderCover(current);
        }

        window.__gemmieSyncNowPlaying?.();

        // expand/collapse toggle (snaps instantly, no animation to track)
        const toggle = document.getElementById('now-playing-toggle');
        const content = document.getElementById('now-playing-content');
        if (toggle && content) {
          const applyExpanded = (expanded) => {
            toggle.setAttribute('aria-expanded', String(expanded));
            content.classList.toggle('is-collapsed', !expanded);
            window.__gemmieSyncNowPlaying?.();
          };

          let startExpanded = false;
          try {
            startExpanded = localStorage.getItem('gemmie-music-player-expanded') === 'true';
          } catch {}
          applyExpanded(startExpanded);

          toggle.addEventListener('click', () => {
            const nowExpanded = toggle.getAttribute('aria-expanded') !== 'true';
            applyExpanded(nowExpanded);
            try {
              localStorage.setItem('gemmie-music-player-expanded', String(nowExpanded));
            } catch {}
          });
        }
      });
    </script>

    <style>
      /* Day/night scene */
      :root {
        --celestial-x: calc(5% - 260px);
        --celestial-y: 14%;
      }
      @media (max-width: 900px) {
        :root {
          --celestial-x: calc(20% - 40px);
        }
      }
      .scene {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        height: 100lvh;
        z-index: -3;
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center, center, center, center, var(--celestial-x) var(--celestial-y), center;
        pointer-events: none;
        transition: opacity 1.4s ease;
      }
      .scene-light {
        background-image:
          url('/images/wallpaper/light/light_lampost.webp'),
          url('/images/wallpaper/light/light_field.webp'),
          url('/images/wallpaper/light/light_clouds.webp'),
          url('/images/wallpaper/light/light_sea.webp'),
          url('/images/wallpaper/light/light_sun.webp'),
          url('/images/wallpaper/light/light_sky.webp');
        opacity: 1;
      }
      .scene-dark {
        background-image:
          url('/images/wallpaper/dark/dark_lampost.webp'),
          url('/images/wallpaper/dark/dark_field.webp'),
          url('/images/wallpaper/dark/dark_clouds.webp'),
          url('/images/wallpaper/dark/dark_sea.webp'),
          url('/images/wallpaper/dark/dark_moon.webp'),
          url('/images/wallpaper/dark/dark_sky.webp');
        opacity: 0;
      }
      :root[data-theme="dark"] .scene-light {
        opacity: 0;
      }
      :root[data-theme="dark"] .scene-dark {
        opacity: 1;
      }

      .site-banner {
        max-width: 1360px;
        margin: 0 auto;
        padding: 28px 16px 0;
        position: relative;
        z-index: 1;
      }
      .site-banner img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0;

        border: 1px solid var(--glass-border);
      }

      .theme-toggle {
        position: fixed;
        top: 16px;
        right: 16px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid var(--glass-border);
        background: var(--glass-fill-strong);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        cursor: pointer;
        z-index: 50;
      }

      /* gemmie angel, for the angelic clique. */
      .corner-mascot {
        position: fixed;
        right: 16px;
        bottom: 16px;
        width: 57px;
        height: auto;
        z-index: 40;
        pointer-events: none;
      }
      @media (max-width: 640px) {
        .corner-mascot {
          display: none;
        }
      }

      /* bandcamp embed */
      .now-playing-widget {
        position: fixed;
        left: 20px;
        bottom: 0px;
        width: 250px;
        z-index: 40;
      }
      @media (max-width: 640px) {
        .now-playing-widget {
          display: none;
        }
      }
      /* flip stacking so the title bar stays pinned at the bottom and content opens upward above it */
      .now-playing-widget .window {
        display: flex;
        flex-direction: column-reverse;
      }
      /* snap open/closed instead of animating, so the floating iframe never
         needs to chase a moving target (see .now-playing-toggle's click handler) */
      .now-playing-widget .nav-section-content {
        transition: none;
      }

      .now-playing-toggle {
        display: block;
        width: 100%;
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        position: relative;
        text-align: left;
      }
      .now-playing-toggle::after {
        content: '▾';
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--ink-inverse);
        text-shadow: 0 1px 1px rgba(0, 0, 0, 0.35);
        transition: transform 0.2s ease;
      }
      .now-playing-toggle[aria-expanded="true"]::after {
        transform: translateY(-50%) rotate(180deg);
      }
      .theme-icon {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        transition: opacity 0.4s ease, transform 0.4s ease;
      }
      :root[data-theme="light"] .sun-icon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }
      :root[data-theme="light"] .moon-icon {
        opacity: 0;
        transform: rotate(-90deg) scale(0.6);
      }
      :root[data-theme="dark"] .sun-icon {
        opacity: 0;
        transform: rotate(90deg) scale(0.6);
      }
      :root[data-theme="dark"] .moon-icon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }
    </style>
  </body>
</html>
