---
import Layout from '../../layouts/Layout.astro';
import PageShell from '../../components/PageShell.astro';
import DocBanner from '../../components/DocBanner.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { tagHue } from '../../lib/tagColor';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const thumbnailUrl = `/images/blog/${encodeURIComponent(post.data.thumbnail)}`;
---

<Layout title={`${post.data.title} ☆ Gemmie's corner`} description={post.data.excerpt} image={thumbnailUrl} feedUrl="/blog/rss.xml">
  <PageShell showMisc={false}>
    <!-- ================= blog post window ================= -->
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true">📰</span>
        <span class="title-bar-text">gemmies-blog.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="blog-post">
          <DocBanner src="/images/banners/banner_blog.png" alt="My Blog" />

          <a class="blog-back-link" href="/blog">‹ Back to Blog</a>

          <article class="blog-article">
            <img class="blog-hero-img" src={thumbnailUrl} alt="" />
            <h1 class="blog-title">{post.data.title}</h1>
            <div class="blog-meta">
              <span class="blog-date">{formattedDate}</span>
              {post.data.tags.length > 0 && (
                <div class="blog-tag-row">
                  {post.data.tags.map((tag) => (
                    <span class="blog-tag" style={`--tag-hue:${tagHue(tag)}`}>#{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <div class="blog-article-body">
              <Content />
            </div>
          </article>

          <a class="blog-back-link" href="/blog">‹ Back to Blog</a>
        </div>
      </div>
    </section>

    <!-- same lightbox as in art -->
    <div class="art-lightbox" id="art-lightbox" hidden>
      <div class="art-lightbox-backdrop" data-close></div>
      <div class="art-lightbox-frame window">
        <div class="title-bar">
          <span class="title-bar-icon" aria-hidden="true">🖼️</span>
          <span class="title-bar-text" id="art-lightbox-title"></span>
          <div class="title-bar-controls" aria-hidden="true">
            <span class="tb-btn close" data-close>×</span>
          </div>
        </div>
        <div class="art-lightbox-body" id="art-lightbox-body"></div>
        <button class="art-lightbox-nav art-lightbox-prev" type="button" id="art-lightbox-prev" aria-label="Previous image">‹</button>
        <button class="art-lightbox-nav art-lightbox-next" type="button" id="art-lightbox-next" aria-label="Next image">›</button>
      </div>
    </div>
  </PageShell>
</Layout>

<script>
  // soundboard for the blog posts
  document.addEventListener('astro:page-load', () => {
    const audioCache = new Map<string, HTMLAudioElement>();
    document.querySelectorAll<HTMLElement>('.blog-article-body .sound-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const file = btn.dataset.sound;
        if (!file) return;
        const src = file.startsWith('/') ? file : `/images/blog/${file}`;
        let audio = audioCache.get(src);
        if (!audio) {
          audio = new Audio(src);
          audioCache.set(src, audio);
        }
        audio.currentTime = 0;
        void audio.play();
      });
    });

    // click to open images in the lightbox + left and right buttons
    const lightbox = document.getElementById('art-lightbox');
    const lightboxBody = document.getElementById('art-lightbox-body');
    const lightboxTitle = document.getElementById('art-lightbox-title');
    const prevBtn = document.getElementById('art-lightbox-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('art-lightbox-next') as HTMLButtonElement | null;
    const images = Array.from(
      document.querySelectorAll<HTMLImageElement>('.blog-article-body img:not(.sticker)')
    );

    if (lightbox && lightboxBody && lightboxTitle && prevBtn && nextBtn && images.length > 0) {
      let currentIndex = -1;

      const renderCurrent = () => {
        const img = images[currentIndex];
        if (!img) return;
        lightboxTitle.textContent = img.alt || '';
        lightboxBody.innerHTML = `<img src="${img.currentSrc || img.src}" alt="${img.alt || ''}" />`;
      };

      const step = (delta: number) => {
        currentIndex = (currentIndex + delta + images.length) % images.length;
        renderCurrent();
      };

      const closeLightbox = () => {
        lightbox.hidden = true;
        lightboxBody.innerHTML = '';
        currentIndex = -1;
      };

      images.forEach((img, i) => {
        img.addEventListener('click', () => {
          currentIndex = i;
          renderCurrent();
          lightbox.hidden = false;
          const hasMultiple = images.length > 1;
          prevBtn.hidden = !hasMultiple;
          nextBtn.hidden = !hasMultiple;
        });
      });

      prevBtn.addEventListener('click', () => step(-1));
      nextBtn.addEventListener('click', () => step(1));
      lightbox.querySelectorAll<HTMLElement>('[data-close]').forEach((el) => {
        el.addEventListener('click', closeLightbox);
      });
      document.addEventListener('keydown', (e) => {
        if (lightbox.hidden) return;
        if (e.key === 'Escape') closeLightbox();
        else if (e.key === 'ArrowLeft') step(-1);
        else if (e.key === 'ArrowRight') step(1);
      });
    }
  });
</script>
