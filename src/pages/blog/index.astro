---
import Layout from '../../layouts/Layout.astro';
import PageShell from '../../components/PageShell.astro';
import { getCollection } from 'astro:content';
import path from 'node:path';
import { getImageThumb } from '../../lib/imageThumb';
import { tagHue } from '../../lib/tagColor';
import Sticker from '../../components/Sticker.astro';

const BLOG_IMAGES_DIR = path.join(process.cwd(), 'public', 'images', 'blog');
const THUMB_WIDTH = 480;

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const posts = await Promise.all(
  allPosts.map(async (post) => ({
    slug: post.slug,
    title: post.data.title,
    excerpt: post.data.excerpt,
    tags: post.data.tags,
    thumbUrl:
      (await getImageThumb(path.join(BLOG_IMAGES_DIR, post.data.thumbnail), THUMB_WIDTH)) ??
      `/images/blog/${encodeURIComponent(post.data.thumbnail)}`,
  }))
);

const allTags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags))).sort((a, b) =>
  a.localeCompare(b)
);

const feedUrl = 'https://gemmiewow.com/blog/rss.xml';
---

<Layout title="Blog ☆ Gemmie's corner" feedUrl="/blog/rss.xml" verifyMeta="QD8Y4Xm8a0u7BBnG5lek">
  <PageShell showMisc={false}>
    <!-- ================= blog window ================= -->
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="white_letter.gif" /></span>
        <span class="title-bar-text">gemmies-blog.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="blog">
          <div class="doc-banner">
            <span class="bubble-wrap" style="left: 8%; animation-duration: 3.2s; animation-delay: -0.5s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 26%; animation-duration: 4s; animation-delay: -2s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 46%; animation-duration: 3.5s; animation-delay: -1.2s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 66%; animation-duration: 4.5s; animation-delay: -3s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 84%; animation-duration: 3.8s; animation-delay: -1.8s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <img class="doc-banner-img" src="/images/banners/banner_blog.png" alt="My Blog" />
          </div>

          <p class="hand-note">
            📰 Stuff about me, games, characters I love, art, thoughts and more!
            Articles may contain <strong><font color="--accent-teal"> soundboard </font></strong>, so keep that volume low.
          </p>

          

          {allTags.length > 0 && (
            <div class="blog-tag-filters" role="group" aria-label="Filter posts by tag">
              <button class="blog-tag-filter is-active" type="button" data-tag="__all__">All</button>
              {allTags.map((tag) => (
                <button
                  class="blog-tag-filter"
                  type="button"
                  data-tag={tag}
                  style={`--tag-hue:${tagHue(tag)}`}
                >
                  #{tag}
                </button>
              ))}
            </div>
          )}

          {posts.length > 0 ? (
            <div class="blog-grid">
              {posts.map((post) => (
                <a class="blog-card" href={`/blog/${post.slug}`} data-tags={post.tags.join('|')}>
                  <img class="blog-card-thumb" src={post.thumbUrl} alt="" loading="lazy" />
                  <div class="blog-card-body">
                    <h2 class="blog-card-title">{post.title}</h2>
                    <p class="blog-card-excerpt">{post.excerpt}</p>
                    {post.tags.length > 0 && (
                      <div class="blog-tag-row">
                        {post.tags.map((tag) => (
                          <span class="blog-tag" style={`--tag-hue:${tagHue(tag)}`}>#{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <p class="hand-note">No posts yet — check back soon!</p>
          )}
        </div>

        <div class="blog-subscribe">
            <style>
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview {
                display: flex !important;
                flex-direction: column !important;
                justify-content: center !important;
                margin-top: 4px !important;
                padding: clamp(17px, 5%, 40px) clamp(17px, 7%, 50px) !important;
                max-width: none !important;
                border-radius: 6px !important;
                box-shadow: var(--shadow-soft) !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview,
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview * {
                box-sizing: border-box !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-heading {
                width: 100% !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-heading h5 {
                margin-top: 0 !important;
                margin-bottom: 0 !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-input-field {
                margin-top: 20px !important;
                width: 100% !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-input-field input {
                width: 100% !important;
                height: 40px !important;
                border-radius: 6px !important;
                border: 1px solid var(--card-border) !important;
                background-color: var(--surface-hover);
                outline: none !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-input-field input {
                color: var(--ink) !important;
                font-family: var(--font-ui) !important;
                font-size: 14px;
                font-weight: 400;
                line-height: 20px;
                text-align: center;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-input-field input::placeholder {
                color: var(--ink-soft) !important;
                opacity: 1 !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-input-field input:-ms-input-placeholder {
                color: var(--ink-soft) !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-input-field input::-ms-input-placeholder {
                color: var(--ink-soft) !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-submit-button {
                margin-top: 10px !important;
                width: 100% !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-submit-button button {
                width: 100% !important;
                height: 40px !important;
                border: 0 !important;
                border-radius: 6px !important;
                line-height: 0px !important;
                background: linear-gradient(180deg, #ffffff 0%, #e6ddf7 45%, #ab98e6 46%, #cdb8f0 100%) !important;
                color: var(--ink) !important;
                font-family: var(--font-ui) !important;
                transition: transform 0.12s ease !important;
              }
              :root[data-theme="dark"] .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-submit-button button {
                background: linear-gradient(180deg, #6a5aa8 0%, #4a3d7a 45%, #332a5c 46%, #241d44 100%) !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .form-preview .preview-submit-button button:hover {
                cursor: pointer !important;
                transform: translateY(-1px) !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .powered-by-line {
                color: var(--ink-soft) !important;
                font-family: var(--font-ui) !important;
                font-size: 13px !important;
                font-weight: 400 !important;
                line-height: 25px !important;
                text-align: center !important;
                text-decoration: none !important;
                display: flex !important;
                width: 100% !important;
                justify-content: center !important;
                align-items: center !important;
                margin-top: 10px !important;
              }
              .followit--follow-form-container[attr-a][attr-b][attr-c][attr-d][attr-e][attr-f] .powered-by-line img {
                margin-left: 10px !important;
                height: 1.13em !important;
                max-height: 1.13em !important;
              }
            </style>
            <div class="followit--follow-form-container" attr-a attr-b attr-c attr-d attr-e attr-f>
              <form action="https://api.follow.it/subscription-form/NWNmVmdteDFIQW1GL2pHWVptem8yUS8xT2xMNDNUbzJESHU1cnF4OG0xZ1lRdFZUUGRWcHlpQk9tZk14aWpQd09PMUNkeXQ5UUhtQ2MzeEVXYVRYN0RKYlpZcW5jVC9SK0NVZGFncFRETkt1Vm9lU20wK0ljSlFUbktPbnhHRG18N3g2Z3BmV0pCRmZZTmVWV2FrNjVzY1EwbWFySFFicEV2SXlNRW9wUGVCMD0=/8" method="post">
                <div style="background-color: var(--surface); position: relative; border-style: solid; border-width: 4px; border-color: var(--card-border);" class="form-preview">
                  <div class="preview-heading">
                    <h5 style="font-family: var(--font-ui); font-weight: 700; color: var(--ink); font-size: 20px; text-align: center; text-transform: none !important;">📡 Want an email whenever I post? Subscribe to my newsletter!</h5>
                  </div>
                  <div class="preview-input-field">
                    <input type="email" name="email" required placeholder="Enter your email" spellcheck="false" style="font-family: var(--font-ui); font-weight: 400; color: var(--ink); font-size: 14px; text-align: center; background-color: var(--surface-hover); text-transform: none !important;">
                  </div>
                  <div class="preview-submit-button">
                    <button type="submit" style="font-family: var(--font-ui); font-weight: bold; font-size: 16px; text-align: center; text-transform: none !important;">Subscribe</button>
                  </div>
                </div>
              </form>
              <a href="https://follow.it" class="powered-by-line">Powered by <img src="https://follow.it/images/colored-logo.svg" alt="follow.it" height="17px" /></a>
            </div>

            <p class="blog-subscribe-rss-note">
              <Sticker name="blue_friends.gif" /> Prefer an RSS reader instead? The feed link works there too:
            </p>
            <div class="embed-row">
              <input class="embed-input" type="text" readonly value={feedUrl} />
              <button class="embed-copy-btn" type="button" data-copy-text={feedUrl}>Copy</button>
            </div>
          </div>


      </div>
    </section>
  </PageShell>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.blog-tag-filter'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.blog-card'));
    if (filterBtns.length === 0 || cards.length === 0) return;

    const active = new Set<string>();

    const applyFilter = () => {
      cards.forEach((card) => {
        const tags = (card.dataset.tags || '').split('|').filter(Boolean);
        card.hidden = active.size > 0 && !tags.some((tag) => active.has(tag));
      });
    };

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag!;
        if (tag === '__all__') {
          active.clear();
        } else if (active.has(tag)) {
          active.delete(tag);
        } else {
          active.add(tag);
        }
        filterBtns.forEach((b) => {
          const isAll = b.dataset.tag === '__all__';
          b.classList.toggle('is-active', isAll ? active.size === 0 : active.has(b.dataset.tag!));
        });
        applyFilter();
      });
    });

    // feed-link copy button (same pattern as the webring embed snippet)
    const feedInput = document.querySelector<HTMLInputElement>('.blog-subscribe .embed-input');
    feedInput?.addEventListener('click', () => feedInput.select());

    const copyBtn = document.querySelector<HTMLButtonElement>('.blog-subscribe .embed-copy-btn');
    if (copyBtn) {
      const defaultLabel = copyBtn.textContent || 'Copy';
      copyBtn.addEventListener('click', async () => {
        const text = copyBtn.dataset.copyText || '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          feedInput?.select();
          document.execCommand('copy');
        }
        copyBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.textContent = defaultLabel;
        }, 1500);
      });
    }
  });
</script>
