---
import Layout from '../../layouts/Layout.astro';
import PageShell from '../../components/PageShell.astro';
import { getCollection } from 'astro:content';
import path from 'node:path';
import { getImageThumb } from '../../lib/imageThumb';
import { tagHue } from '../../lib/tagColor';
import Sticker from '../../components/Sticker.astro';
import DocBanner from '../../components/DocBanner.astro';
import RssIcon from '../../components/RssIcon.astro';

const BLOG_IMAGES_DIR = path.join(process.cwd(), 'public', 'images', 'blog');
const THUMB_WIDTH = 480;

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const posts = await Promise.all(
  allPosts.map(async (post) => ({
    slug: post.slug,
    title: post.data.title,
    excerpt: post.data.excerpt,
    tags: post.data.tags,
    thumbUrl:
      (await getImageThumb(path.join(BLOG_IMAGES_DIR, post.data.thumbnail), THUMB_WIDTH)) ??
      `/images/blog/${encodeURIComponent(post.data.thumbnail)}`,
  }))
);

const allTags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags))).sort((a, b) =>
  a.localeCompare(b)
);
---

<Layout title="Blog ☆ Gemmie's corner" feedUrl="/blog/rss.xml">
  <PageShell showMisc={false}>
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="white_letter.gif" /></span>
        <span class="title-bar-text">gemmies-blog.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="blog">
          <DocBanner src="/images/banners/banner_blog.png" alt="My Blog" />

          <p class="hand-note">
            📰 Stuff about me, games, characters I love, art, thoughts and more!
            Articles may contain <strong><font color="--accent-teal"> soundboard </font></strong>, so keep that volume low.
            <RssIcon class="rss-inline" href="/blog/rss.xml" title="blog feed. Add it to your rss reader!" label="Blog RSS feed" />
          </p>

          

          {allTags.length > 0 && (
            <div class="blog-tag-filters" role="group" aria-label="Filter posts by tag">
              <button class="blog-tag-filter is-active" type="button" data-tag="__all__">All</button>
              {allTags.map((tag) => (
                <button
                  class="blog-tag-filter"
                  type="button"
                  data-tag={tag}
                  style={`--tag-hue:${tagHue(tag)}`}
                >
                  #{tag}
                </button>
              ))}
            </div>
          )}

          {posts.length > 0 ? (
            <div class="blog-grid">
              {posts.map((post) => (
                <a class="blog-card" href={`/blog/${post.slug}`} data-tags={post.tags.join('|')}>
                  <img class="blog-card-thumb" src={post.thumbUrl} alt="" loading="lazy" />
                  <div class="blog-card-body">
                    <h2 class="blog-card-title">{post.title}</h2>
                    <p class="blog-card-excerpt">{post.excerpt}</p>
                    {post.tags.length > 0 && (
                      <div class="blog-tag-row">
                        {post.tags.map((tag) => (
                          <span class="blog-tag" style={`--tag-hue:${tagHue(tag)}`}>#{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <p class="hand-note">No posts yet</p>
          )}
        </div>

        <div class="blog-subscribe">
            <p class="hand-note">📡 Want an email whenever I post? Subscribe to my newsletter!</p>
            <div class="buttondown-embed-frame">
              <iframe
                src="https://buttondown.com/Gemmiewow?as_embed=true"
                title="Subscribe to Gemmie's newsletter"
                loading="lazy"
              ></iframe>
            </div>
          </div>


      </div>
    </section>
  </PageShell>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.blog-tag-filter'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.blog-card'));
    if (filterBtns.length === 0 || cards.length === 0) return;

    const active = new Set<string>();

    const applyFilter = () => {
      cards.forEach((card) => {
        const tags = (card.dataset.tags || '').split('|').filter(Boolean);
        card.hidden = active.size > 0 && !tags.some((tag) => active.has(tag));
      });
    };

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag!;
        if (tag === '__all__') {
          active.clear();
        } else if (active.has(tag)) {
          active.delete(tag);
        } else {
          active.add(tag);
        }
        filterBtns.forEach((b) => {
          const isAll = b.dataset.tag === '__all__';
          b.classList.toggle('is-active', isAll ? active.size === 0 : active.has(b.dataset.tag!));
        });
        applyFilter();
      });
    });
  });
</script>
