---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import Sticker from '../components/Sticker.astro';
import { emojiGroups } from '../data/clipboard';
---

<Layout title="Clipboard ☆ Gemmie's corner">
  <PageShell showMisc={false}>
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="orange_cat.gif" /></span>
        <span class="title-bar-text">clipboard.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section">
          <p class="hand-note" id="clip-status" aria-live="polite">Emojis and kaomoji that I use regularly, click to copy!</p>
        </div>

        <div class="doc-section" id="clipboard-emoji">
          {emojiGroups.map((group) => (
            <div class="code-resource">
              <h3 class="links-section-heading">{group.title}</h3>
              <div class="friends-grid">
                {group.items.map((item) => (
                  <button class="clip-btn" type="button" data-clip={item}>{item}</button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </PageShell>
</Layout>

<style>
  .clip-btn {
    padding: 6px 10px;
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--surface-hover);
    border: 1px solid var(--card-border);
    border-radius: 0;
    cursor: pointer;
    transition: transform 0.12s ease, border-color 0.12s ease;
  }
  .clip-btn:hover,
  .clip-btn:focus-visible {
    border-color: var(--accent-deep);
    transform: translateY(-1px);
  }
  .clip-btn:active {
    transform: translateY(0);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const status = document.getElementById('clip-status');
    if (!status) return;
    const defaultText = status.textContent || '';
    let timer: ReturnType<typeof setTimeout> | undefined;

    document.querySelectorAll<HTMLButtonElement>('.clip-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.clip || '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          status.textContent = 'Could not copy (╥﹏╥) try selecting it instead!';
          return;
        }
        status.textContent = `Copied ${text} !`;
        clearTimeout(timer);
        timer = setTimeout(() => {
          status.textContent = defaultText;
        }, 1800);
      });
    });
  });
</script>
