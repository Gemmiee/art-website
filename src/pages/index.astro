---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import WaterButton from '../components/WaterButton.astro';
import BubbleDivider from '../components/BubbleDivider.astro';
import Sticker from '../components/Sticker.astro';

// Scanned straight off the folder rather than hardcoded, so dropping a new
// blinkie .gif in public/images/blinkies_stamps_tags/blinkies is enough —
// no code change needed to make it show up in the marquee.
const blinkiesDir = path.join(process.cwd(), 'public', 'images', 'blinkies_stamps_tags', 'blinkies');
const blinkies = fs.existsSync(blinkiesDir)
  ? fs
      .readdirSync(blinkiesDir)
      .filter((name) => name.toLowerCase().endsWith('.gif'))
      .sort()
      .map((name) => `/images/blinkies_stamps_tags/blinkies/${name}`)
  : [];

const updates = [
  { date: '09/04', text: 'Ive noticed all this time, we didnt have an about-me page. Now we do lolol' },
  { date: '09/03', text: 'Posted some code snippets used on this site :>' },
  { date: '09/29', text: 'Music got a new look 🌀 you can now select your music from the new music page! Did I mention that music keeps playing even when you switch pages? (°□°) ა🥬' },
  { date: '09/23', text: 'Blog is here! YAAAAAAYYYY! More spending your time! Plus newsletter!' },
  { date: '09/18', text: 'Commissions page is done and open woohoo :o' },
  { date: '09/17', text: 'New game added: Metal Slug X!' },
  { date: '09/05', text: 'Art gallery is finally open! Go Go Go!!' },
  { date: '08/29', text: 'Guestbook is now availablee wheeeee' },
  { date: '08/27', text: 'Added Paint!' },
  { date: '08/26', text: 'We got games! Space Cadet Pinball and Spider Solitaire!!' },
  { date: '08/25', text: 'Chat is now open! Leave your messages theeree' },
  { date: '08/24', text: 'Yooo we got a status noowww' },
  { date: '08/23', text: 'Added music, social media and friends!' },
  { date: '08/22', text: 'Dark mode + layered day/night wallpaper added' },
  { date: '08/21', text: 'Added art banners and maaany art components, will add more overtime teehee' },
  { date: '08/18', text: 'Redesigned into a 3-column desktop layout' },
  { date: '08/17', text: 'Windows Aero glass' },
];

const announcements = [
  'HELLO! University is starting, therefore I might not make many new updates. I wont stop working on the site though when I get time! Thanks for sticking around!',
  'YO blog is finally here! 📰 Fr cant believe it, more posts will come soon!',
  'Site is perpetually a work in progress',
];
---

<Layout>
  <PageShell>
    <!-- for sanrio webring -->
    <link href="https://luckyatoll.nekoweb.org/sanriowebring.css" rel="stylesheet" type="text/css" media="all"/>
    
    <!-- ================= single merged content window ================= -->
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="yellow_sunflower.gif" /></span>
        <span class="title-bar-text">gemmies-site.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <!-- ---- about me ---- -->
        <div class="doc-section" id="about">
          <div class="profile-grid">
            <div class="avatar-frame">
              <center>
                <h1>Gemmie <span class="sparkle">☆</span></h1>
                <button type="button" class="avatar-trigger" id="gemmie-trigger" aria-label="Boop Gemmie">
                  <span class="avatar-stage" id="gemmie-stage">
                    <img class="avatar-img avatar-img-normal" src="/images/other_components/GemmieBust.webp" alt="Gemmie bust illustration" />
                    <img class="avatar-img avatar-img-burned" id="gemmie-burned" src="/images/other_components/BurnedGemmie.gif" alt="" aria-hidden="true" />
                    <img class="avatar-explosion" id="gemmie-explosion" src="/images/other_components/explosion.gif" alt="" aria-hidden="true" />
                  </span>
                </button>
              </center>
            </div>
            <div>
            
              
              <div class="bio-banner">
                <img class="bio-doodle" src="/images/other_components/gemmie_doodle.png" alt="" aria-hidden="true" />
                <img class="bio-banner-img" src="/images/banners/banner_bio.png" alt="Female — Cartoon Artist + Animator" />
              </div>

              <!-- ---- display: flex, so that they appear side by side :3 ---- -->
              <div class="bio-icons">
                  <img src="/images/blinkies_stamps_tags/tags/tag_greek.png" alt="Greek" />
                  <img src="/images/blinkies_stamps_tags/tags/tag_intp.png" alt="INTP" />
                  <img src="/images/blinkies_stamps_tags/tags/tag_sanrio.png" alt="Sanrio" />
                  <img src="/images/blinkies_stamps_tags/tags/tag_darkestdungeon.png" alt="Darkness Dungeon" />
              </div>
              
              <p class="blurb">
                <Sticker name="blue_computer.gif" /> Studying Software Engineering in uni.
                <br />
                <Sticker name="white_penguin.gif" /> Linux Mint user.
                <br />
                <Sticker name="blue_shark.gif" /> Fan of many things: my PSVita &amp; 3DS, frutiger aero, cats, Python, sunflowers, art + animation, music and CDs.
              </p>
              <WaterButton
                href="https://code.gemmiewow.com/"
                label="🌍 Visit my Programming Portfolio"
                waterColor="#3fbfc7"
                external
              />
              

              <WaterButton
                href="/art/commissions"
                label="💌 See my commissions here!"
                waterColor="#d472a1"
              />

            </div>
          </div>
        </div>

        <BubbleDivider />

        <!-- ---- site updates + announcements ---- -->
        <div class="doc-section" id="updates">
          <div class="inner-window-grid">
            <div class="update-card">
              <div class="update-card-banner">
                <img src="/images/banners/banner_site_updates.png" alt="Site Updates" />
              </div>
              <div class="update-card-body card-border">
                <div class="update-card-scroll scroll-border">
                  <ul class="update-list">
                    {updates.map((u) => (
                      <li><span class="update-date">{u.date}</span> {u.text}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <div class="update-card">
              <div class="update-card-banner">
                <img src="/images/banners/banner_announcements.png" alt="Announcements" />
              </div>
              <div class="update-card-body card-border">
                <div class="update-card-scroll scroll-border">
                  <ul class="update-list">
                    {announcements.map((a) => (
                      <li><span class="update-bullet" aria-hidden="true">☆</span> {a}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <BubbleDivider />

        <!-- ---- what is this site ---- -->
        <div class="doc-section" id="what-is-this">
          <img class="section-banner" src="/images/banners/banner_what_is_this.png" alt="What is this?" />
          <div class="article-grid">
            <div class="article-portrait">
              <img class="article-portrait-img" src="/images/other_components/Gemmie_sit.png" alt="Gemmie sitting illustration" />
            </div>
            <div>
              <p class="blurb">
                <Sticker name="yellow_sunflower.gif" /> Welcome to my website! This is my little personal spot on the internet filled with art and games.
                I keep adding new stuff, so make sure you check the 'Site Updates' above.
                <span class="sparkle">☆</span>
              </br>
              </br>
                <Sticker name="blue_teddybear.gif" /> Leave your comments and feedback in my <a href="/guestbook" class="guestbook-link">guestbook</a>! I would love to hear from you! <span class="sparkle">☆</span>
              </br>
              </br>
              <Sticker name="blue_castle.gif" /> If you enjoy the site, consider bookmarking it! Add my button to your own website or we can become neighbours!!
              </p>
            </div>
          </div>

          {blinkies.length > 0 && (
            <>
              <p class="hand-note">⋆ a little blinkie collection ⋆</p>
              <div class="blinkie-marquee">
                <div class="blinkie-marquee-track">
                  {blinkies.map((src) => (
                    <img class="blinkie-item" src={src} alt="" loading="lazy" />
                  ))}
                  {/* repeat so the marquee can loop seamlessly */}
                  {blinkies.map((src) => (
                    <img class="blinkie-item" src={src} alt="" aria-hidden="true" loading="lazy" />
                  ))}
                </div>
              </div>
            </>
          )}
        </div>

        <BubbleDivider />

        <!-- ---- shop + webrings ---- -->
 
        <div class="doc-section" id="shop">
          <div class="shop-grid">
            <div class="shop-col">
              <img class="section-banner" src="/images/banners/banner_shop.png" alt="Click for shop!" />
              <a href="https://ko-fi.com/gemmiewow/" target="_blank" rel="noopener noreferrer">
                <img class="shop-img" src="/images/cards/card_shop.png" alt="Gemmie's Ko-fi shop" />
              </a>
            </div>

            <div class="shop-col">
              <h2 class="links-section-heading">🔗 Webrings</h2>
              <p class="hand-note">Webrings I'm part of: see <a href="/links">links page</a></p>

              <div class="webring-scroll-box webring-stack">
                <a class="offsite-btn" href="https://petrapixel.neocities.org/indiewebdb/" target="_blank" rel="noopener" aria-label="indie web database">
                  <img src="https://cdn.jsdelivr.net/gh/petracoding/petrapixel.neocities.org@latest/public/assets/img/links/indiewebdb.png" alt="indie web database" loading="lazy" />
                </a>



                <!-- Online Widget -->
                <map name="onlinewidget">
                <area href="https://webring.ghostk.id/online/" target="_blank" shape="rect" coords="20,14,167,24" alt="The online webring" title="The online webring">
                <area href="https://webring.ghostk.id/online/Gemmie/previous" target="_top" shape="rect" coords="7,27,60,36" alt="Previous" title="Previous">
                <area href="https://webring.ghostk.id/online/random" target="_top" shape="rect" coords="74,27,126,36" alt="Random" title="Random">
                <area href="https://webring.ghostk.id/online/Gemmie/next" target="_top" shape="rect" coords="139,27,192,36" alt="Next" title="Next">
                </map>
                <img usemap="#onlinewidget" src="https://ghostk.id/i/onlinepurple.gif" width="200" height="40" style="width:200px;height:40px;max-width:none;image-rendering:pixelated;" alt="A Windows style dialog box titled 'THE ONLINE WEBRING' with three clickable buttons labeled Previous, Random, and Next" class="offsite-imagemap" />

                <!-- Sanrio Webring -->
                <div class="sanringo cinnamoroll">
                <a class="title" href="https://luckyatoll.nekoweb.org/sanringo.html">Sanrio Webring</a>
                <br>
                <a class="prev" href="https://luckyatoll.nekoweb.org/sanringo.html?action=previous"><img src="https://luckyatoll.nekoweb.org/images/pinkarrow.png"></a>
                <img class="character" src="https://www.sanrio.co.jp/special/characterranking/2020/assets/img/common/character/cinnamon.png">
                <a class="next" href="https://luckyatoll.nekoweb.org/sanringo.html?action=next"><img src="https://luckyatoll.nekoweb.org/images/pinkarrow.png"></a>
                <br>
                <a class="info" href="https://luckyatoll.nekoweb.org/sanringo.html">what's this?</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </PageShell>
</Layout>

<script>
  // Gemmie kaboom easter egg
  document.addEventListener('astro:page-load', () => {
    const trigger = document.getElementById('gemmie-trigger');
    const stage = document.getElementById('gemmie-stage');
    const explosionImg = document.getElementById('gemmie-explosion') as HTMLImageElement | null;
    const burnedImg = document.getElementById('gemmie-burned') as HTMLImageElement | null;
    if (!trigger || !stage || !explosionImg || !burnedImg) return;

    const SPAM_WINDOW_MS = 1500;
    const CLICKS_TO_EXPLODE = 7;
    const BOOM_LEAD_MS = 80; // sound starts a beat before the visual blast
    const BLAST_LEAD_MS = 250; // explosion shows a beat before burned swaps in, so it reads as cause->effect
    // explosion.gif's own loop is ~1.41s (42 frames) — fade has to start just
    // before that, or it visibly restarts into a second loop before fading.
    const BLAST_MS = 1380;
    const BLAST_FADE_MS = 500; // matches the CSS transition duration on .is-blast-fading
    const BURNED_HOLD_MS = 5000;

    const SQUEAK_SRC = '/sounds/teddy-bear-squeak.mp3';
    const BOOM_SRC = '/sounds/roblox-explosion.mp3';
    const EXPLOSION_SRC = '/images/other_components/explosion.gif';
    const BURNED_SRC = '/images/other_components/BurnedGemmie.gif';

    let clickCount = 0;
    let lastClickTime = 0;
    let exploding = false;

    // Fresh Audio per play (not reusing+rewinding one element) so rapid
    // clicks layer overlapping sounds instead of cutting each other off.
    const playSound = (src: string) => {
      void new Audio(src).play();
    };

    // A query-string bust forces a real reload+redecode every time; reusing
    // the exact same src string is a no-op in some browsers and leaves the
    // gif frozen on its last (often faded-out) frame on repeat loops.
    const restartGif = (img: HTMLImageElement, baseSrc: string) => {
      img.src = `${baseSrc}?r=${Date.now()}`;
    };

    trigger.addEventListener('click', () => {
      if (exploding) return;
      const now = Date.now();
      if (now - lastClickTime > SPAM_WINDOW_MS) clickCount = 0;
      lastClickTime = now;
      clickCount++;

      if (clickCount >= CLICKS_TO_EXPLODE) {
        clickCount = 0;
        exploding = true;
        stage.classList.remove('is-booping');
        playSound(BOOM_SRC);

        setTimeout(() => {
          restartGif(explosionImg, EXPLOSION_SRC);
          stage.classList.add('is-blasting');
        }, BOOM_LEAD_MS);

        setTimeout(() => {
          restartGif(burnedImg, BURNED_SRC);
          stage.classList.add('is-exploding');
        }, BOOM_LEAD_MS + BLAST_LEAD_MS);

        setTimeout(() => {
          stage.classList.add('is-blast-fading');
          stage.classList.remove('is-blasting');
          setTimeout(() => stage.classList.remove('is-blast-fading'), BLAST_FADE_MS);
        }, BOOM_LEAD_MS + BLAST_MS); // BLAST_MS still measured from the gif's own start

        setTimeout(() => {
          stage.classList.remove('is-exploding');
          exploding = false;
        }, BOOM_LEAD_MS + BLAST_LEAD_MS + BURNED_HOLD_MS);
        return;
      }

      playSound(SQUEAK_SRC);
      stage.classList.remove('is-booping');
      void stage.offsetWidth; // reflow so the animation can restart on rapid clicks
      stage.classList.add('is-booping');
    });
  });
</script>
