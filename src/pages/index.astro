---
import Layout from '../layouts/Layout.astro';

const quickNav = [
  { emoji: '🙋', label: 'About Me', href: '#about' },
  { emoji: '🖼️', label: 'Art', href: '#art' },
  { emoji: '🌍', label: 'Portfolio', href: '#about' },
];

const miniGames = [
  { icon: '🃏', name: 'solitaire.exe' },
  { icon: '💣', name: 'minesweeper.exe' },
  { icon: '🐍', name: 'snake.exe' },
];

const socials = [
  { emoji: '🛍️', label: 'Ko-fi Shop', href: 'https://ko-fi.com/gemmiewow/' },
  { emoji: '🐠', label: 'Cara Art Portfolio', href: 'https://cara.app/gemmiewow' },
  { emoji: '🪼', label: 'Pixelfed', href: 'https://pixelfed.social/gemmie_wow' },
  { emoji: '👥', label: 'OC Fandom Wiki', href: 'https://shanka-angelo.fandom.com/wiki/Shanka_%26_Angelo_Wiki' },
  { emoji: '📸', label: 'Instagram', href: 'https://www.instagram.com/gemmie_wow' },
  { emoji: '🕹️', label: 'Twitch', href: 'https://www.twitch.tv/gemmie_wow' },
  { emoji: '🎥', label: 'YouTube', href: 'https://youtube.com/@gemmiewow' },
  { emoji: '🎨', label: "Colors!Live 3DS Gallery", href: 'https://www.colorslive.com/artist/GemmieWow' },
];

const updates = [
  { date: '08/22', text: 'Dark mode + layered day/night wallpaper added ☆' },
  { date: '08/21', text: 'Redesigned into a 3-column desktop layout' },
  { date: '08/17', text: 'Windows Aero glass reskin, v1' },
];

const announcements = [
  'Art gallery filling up soon — check back! 🎨',
  'Guestbook & mini-games still under construction 🛠️',
  'Site is perpetually a work in progress ☆',
];
---

<Layout>
  <main class="wrap layout-grid">
    <div class="col-main">
      <!-- ================= single merged content window ================= -->
      <section class="window main-doc">
        <div class="title-bar">
          <span class="title-bar-icon" aria-hidden="true">🌻</span>
          <span class="title-bar-text">gemmies-corner.exe</span>
          <div class="title-bar-controls" aria-hidden="true">
            <span class="tb-btn">_</span>
            <span class="tb-btn">□</span>
            <span class="tb-btn close">×</span>
          </div>
        </div>
        <div class="window-body">
          <!-- ---- about me ---- -->
          <div class="doc-section" id="about">
            <div class="profile-grid">
              <div class="avatar-frame">
                <img class="avatar-img" src="/images/GemmieBust.png" alt="Gemmie bust illustration" />
              </div>
              <div>
                <h1>Gemmie <span class="sparkle">☆</span></h1>
                <p class="tags">Female ♀️ ʕ•ᴥ•ʔ &nbsp;·&nbsp; Cartoon Artist + Animator 🌻</p>
                <p class="blurb">
                  🌱 Studying Software Engineering in uni.
                  <br />🌻 Fan of many things: my PSVita &amp; 3DS, frutiger aero, cats, coding in Python, sunflowers.
                </p>
                <a class="aero-btn portfolio-inline-btn" href="https://gemmiewow.com/" target="_blank" rel="noopener">
                  🌍 Visit my Programming Portfolio
                </a>
              </div>
            </div>
          </div>

          <hr class="doc-divider" />

          <!-- ---- site updates + announcements ---- -->
          <div class="doc-section" id="updates">
            <div class="inner-window-grid">
              <div class="update-card">
                <div class="update-card-banner">
                  <img src="/images/banners/banner_site_updates.png" alt="Site Updates" />
                </div>
                <div class="update-card-body card-ocean">
                  <div class="update-card-scroll scroll-ocean">
                    <ul class="update-list">
                      {updates.map((u) => (
                        <li><span class="update-date">{u.date}</span> {u.text}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <div class="update-card">
                <div class="update-card-banner">
                  <img src="/images/banners/banner_announcements.png" alt="Announcements" />
                </div>
                <div class="update-card-body card-border">
                  <div class="update-card-scroll scroll-border">
                    <ul class="update-list">
                      {announcements.map((a) => (
                        <li><span class="update-bullet" aria-hidden="true">☆</span> {a}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <hr class="doc-divider" />

          <!-- ---- art gallery ---- -->
          <div class="doc-section" id="art">
            <div class="doc-banner">
              <span class="bubble-wrap" style="left: 8%; animation-duration: 3.2s; animation-delay: -0.5s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
              <span class="bubble-wrap" style="left: 26%; animation-duration: 4s; animation-delay: -2s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
              <span class="bubble-wrap" style="left: 46%; animation-duration: 3.5s; animation-delay: -1.2s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
              <span class="bubble-wrap" style="left: 66%; animation-duration: 4.5s; animation-delay: -3s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
              <span class="bubble-wrap" style="left: 84%; animation-duration: 3.8s; animation-delay: -1.8s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
              <h2 class="doc-banner-text"><span aria-hidden="true">🖼️</span> My Art Gallery ☆</h2>
            </div>
            <p class="hand-note">gallery under construction — pieces coming soon ☆</p>
            <div class="gallery-grid">
              {Array.from({ length: 6 }).map(() => (
                <div class="gallery-slot" aria-hidden="true">🖌️</div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="col-nav">
      <!-- ================= navigation ================= -->
      <section class="window compact inactive">
        <div class="title-bar">
          <span class="title-bar-icon" aria-hidden="true">📁</span>
          <span class="title-bar-text">navigate.exe</span>
          <div class="title-bar-controls" aria-hidden="true">
            <span class="tb-btn">_</span>
            <span class="tb-btn">□</span>
            <span class="tb-btn close">×</span>
          </div>
        </div>
        <div class="window-body">
          <ul class="nav-list">
            {quickNav.map((item) => (
              <li>
                <a href={item.href}>
                  <span aria-hidden="true">{item.emoji}</span> {item.label}
                </a>
              </li>
            ))}
          </ul>

          <hr class="doc-divider nav-divider" />

          <p class="nav-subheading" id="games"><span aria-hidden="true">🎮</span> mini-games</p>
          <p class="hand-note">coming soon ☆</p>
          <div class="games-grid">
            {miniGames.map((game) => (
              <div class="game-slot" aria-hidden="true">
                <span class="game-slot-icon">{game.icon}</span>
                <span class="game-slot-lock">🔒</span>
                <span class="game-slot-name">{game.name}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>

    <div class="col-misc">
      <!-- ================= now playing ================= -->
      <section class="window compact inactive" id="now-playing">
        <div class="title-bar">
          <span class="title-bar-icon" aria-hidden="true">♫</span>
          <span class="title-bar-text">nowplaying.mp3</span>
          <div class="title-bar-controls" aria-hidden="true">
            <span class="tb-btn">_</span>
            <span class="tb-btn">□</span>
            <span class="tb-btn close">×</span>
          </div>
        </div>
        <div class="window-body">
          <div class="np-grid">
            <div class="np-art" aria-hidden="true">💿</div>
            <div class="np-info">
              <p class="np-track">Pizza Hotline</p>
              <div class="np-bar"><div class="np-bar-fill"></div></div>
              <div class="np-eq" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= socials ================= -->
      <section class="window compact inactive" id="socials">
        <div class="title-bar">
          <span class="title-bar-icon" aria-hidden="true">☆</span>
          <span class="title-bar-text">socials.txt</span>
          <div class="title-bar-controls" aria-hidden="true">
            <span class="tb-btn">_</span>
            <span class="tb-btn">□</span>
            <span class="tb-btn close">×</span>
          </div>
        </div>
        <div class="window-body">
          <ul class="link-list">
            {socials.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener">
                  <span aria-hidden="true">{link.emoji}</span> {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ================= friend links / webring ================= -->
      <section class="window compact inactive" id="friend-links">
        <div class="title-bar">
          <span class="title-bar-icon" aria-hidden="true">🔗</span>
          <span class="title-bar-text">friend-links.htm</span>
          <div class="title-bar-controls" aria-hidden="true">
            <span class="tb-btn">_</span>
            <span class="tb-btn">□</span>
            <span class="tb-btn close">×</span>
          </div>
        </div>
        <div class="window-body">
          <p class="hand-note">button swaps coming soon ☆</p>
          <div class="friend-grid">
            {Array.from({ length: 4 }).map(() => (
              <div class="friend-slot" aria-hidden="true">88×31</div>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= guestbook ================= -->
      <section class="window compact inactive" id="guestbook">
        <div class="title-bar">
          <span class="title-bar-icon" aria-hidden="true">📖</span>
          <span class="title-bar-text">guestbook.exe</span>
          <div class="title-bar-controls" aria-hidden="true">
            <span class="tb-btn">_</span>
            <span class="tb-btn">□</span>
            <span class="tb-btn close">×</span>
          </div>
        </div>
        <div class="window-body">
          <p class="empty-note">no entries yet — be the first to sign! (coming soon)</p>
          <textarea class="guestbook-input" placeholder="leave a note..." disabled></textarea>
          <button class="aero-btn guestbook-btn" type="button" disabled>sign the guestbook</button>
        </div>
      </section>
    </div>

    <!-- ================= footer ================= -->
    <footer class="footer">
      <div class="badge-row">
        <span class="badge-btn">made w/ astro ☆</span>
        <span class="badge-btn">psvita enjoyer</span>
        <span class="badge-btn">sunflower certified</span>
        <span class="badge-btn">best viewed w/ good vibes</span>
      </div>
      <p class="footer-note">☆ thanks for stopping by my corner of the internet ☆</p>
    </footer>
  </main>

  <style>
    /* ---------- 3-column layout ---------- */
    .layout-grid {
      display: grid;
      grid-template-columns: 180px minmax(0, 1fr) 230px;
      grid-template-areas: "nav main misc" "footer footer footer";
      gap: 24px;
      align-items: start;
    }
    .col-main { grid-area: main; min-width: 0; }
    .col-nav {
      grid-area: nav;
      display: flex;
      flex-direction: column;
      gap: 24px;
      position: sticky;
      top: 20px;
    }
    .col-misc {
      grid-area: misc;
      display: flex;
      flex-direction: column;
      gap: 24px;
      position: sticky;
      top: 20px;
    }
    .footer { grid-area: footer; }

    @media (max-width: 900px) {
      .layout-grid {
        grid-template-columns: 1fr;
        grid-template-areas: "main" "misc" "nav" "footer";
      }
      .col-nav, .col-misc {
        position: static;
      }
    }

    /* ---------- main "active" document window ---------- */
    .window.main-doc {
      box-shadow: 0 20px 44px rgba(26, 18, 46, 0.4), 0 0 0 1px rgba(147, 163, 230, 0.55), 0 2px 0 rgba(255,255,255,0.6) inset;
    }
    .window.main-doc .window-body {
      padding: 28px 30px;
    }

    /* watery goldfish banner for section titles */
    .doc-banner {
      position: relative;
      overflow: hidden;
      height: 66px;
      border-radius: 999px;
      margin: 0 0 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(180deg, #eafcff 0%, #9fe0ea 30%, #93a3e6 65%, #4b3a7a 100%);
      border: 1px solid rgba(255,255,255,0.75);
      box-shadow: 0 6px 14px rgba(30,25,60,0.3), inset 0 2px 4px rgba(255,255,255,0.6);
    }
    .doc-banner::before {
      content: '';
      position: absolute;
      inset: 0 0 55% 0;
      background: linear-gradient(180deg, rgba(255,255,255,0.85), rgba(255,255,255,0));
      pointer-events: none;
    }
    .doc-banner-text {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-banner);
      font-weight: 700;
      font-size: 1.65rem;
      margin: 0;
      color: #ffffff;
      text-shadow: 0 2px 3px rgba(30,25,60,0.55);
      letter-spacing: 0.03em;
    }
    .bubble-wrap {
      position: absolute;
      bottom: -20%;
      z-index: 1;
      opacity: 0.85;
      animation: bubble-rise 6s linear infinite;
    }
    .bubble-icon {
      display: block;
      width: 16px;
      height: 16px;
      animation: bubble-wobble 2.4s ease-in-out infinite;
    }
    @keyframes bubble-rise {
      from { bottom: -20%; }
      to { bottom: 120%; }
    }
    @keyframes bubble-wobble {
      0%, 100% { transform: translateX(-3px); }
      50% { transform: translateX(3px); }
    }

    .doc-divider {
      border: none;
      border-top: 1px dashed var(--card-border);
      margin: 26px 0;
    }

    /* ---------- nested windows: site updates + announcements ---------- */
    .inner-window-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      align-items: start;
    }

    /* site updates + announcements: illustrated cards + overlapping banners */
    .update-card {
      position: relative;
      margin-top: 26px;
    }
    .update-card-banner {
      position: absolute;
      top: -26px;
      left: 50%;
      transform: translateX(-50%) rotate(-2deg);
      width: 78%;
      max-width: 240px;
      z-index: 2;
      filter: drop-shadow(0 4px 8px rgba(26,18,46,0.35));
      pointer-events: none;
    }
    .update-card-banner img {
      display: block;
      width: 100%;
      height: auto;
    }
    .update-card-body {
      position: relative;
      aspect-ratio: 4 / 5;
      border-radius: 14px;
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }
    .card-ocean {
      background-image: url('/images/cards/card_ocean.png');
    }
    .card-border {
      background-image: url('/images/cards/card_border.png');
    }
    .update-card-scroll {
      position: absolute;
      overflow-y: auto;
      border-radius: 10px;
      padding: 10px 12px;
    }
    .update-card-scroll .update-list {
      font-size: 0.72rem;
    }
    /* card_ocean's art is busy edge-to-edge, so the text gets its own frosted panel */
    .scroll-ocean {
      top: 22%;
      left: 8%;
      right: 8%;
      bottom: 12%;
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
      box-shadow: 0 2px 8px rgba(26,18,46,0.2);
    }
    /* card_border already has a pale interior, so text sits straight on it */
    .scroll-border {
      top: 12%;
      left: 12%;
      right: 12%;
      bottom: 12%;
    }
    .update-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 8px;
      font-size: 0.8rem;
      color: var(--ink);
    }
    .update-list li {
      line-height: 1.4;
    }
    .update-date {
      display: inline-block;
      font-weight: 700;
      color: var(--accent-deep);
      margin-right: 4px;
    }
    .update-bullet {
      color: var(--accent-orange);
      margin-right: 2px;
    }

    @media (max-width: 640px) {
      .inner-window-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- "inactive" side windows ---------- */
    .window.inactive {
      background: var(--surface);
      box-shadow: 0 6px 14px rgba(26,18,46,0.16), 0 1px 0 rgba(255,255,255,0.4) inset;
      backdrop-filter: blur(8px) saturate(1.1);
      -webkit-backdrop-filter: blur(8px) saturate(1.1);
    }
    .window.inactive .title-bar {
      background: linear-gradient(180deg, var(--titlebar-inactive-start) 0%, var(--titlebar-inactive-mid) 55%, var(--titlebar-inactive-end) 100%);
      border-bottom: 1px solid var(--titlebar-inactive-border);
    }
    .window.inactive .title-bar::before {
      opacity: 0.35;
    }
    .window.inactive .title-bar-text {
      color: var(--titlebar-inactive-text);
      text-shadow: none;
    }
    .window.inactive .title-bar-icon {
      opacity: 0.7;
      filter: none;
    }
    .window.inactive .tb-btn {
      background: linear-gradient(180deg, var(--tb-btn-start) 0%, var(--tb-btn-end) 100%);
      opacity: 0.8;
    }
    .window.inactive .tb-btn.close {
      background: linear-gradient(180deg, #f0bdb2 0%, #d3897a 100%);
      color: #fff;
      opacity: 0.8;
    }

    .window.compact .window-body {
      padding: 16px;
    }
    .window .title-bar-text {
      font-size: 0.78rem;
    }

    h1 {
      font-family: var(--font-name);
      font-weight: 400;
      font-size: 2.8rem;
      line-height: 1;
      margin: 0 0 10px;
      background: linear-gradient(180deg, #ffb3d1 0%, #ff6fa5 45%, #e14f86 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 2px 2px rgba(26,18,46,0.25));
    }

    .profile-grid {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 22px;
      align-items: start;
    }

    .avatar-frame {
      position: relative;
      max-width: 220px;
    }

    .avatar-img {
      width: 100%;
      height: auto;
    }

    .tags {
      font-size: 0.85rem;
      margin: 0 0 8px;
      color: var(--ink-soft);
      font-weight: 600;
    }

    .blurb {
      margin: 0;
      font-size: 0.92rem;
      line-height: 1.6;
    }

    /* art gallery */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
      gap: 10px;
    }
    .gallery-slot {
      aspect-ratio: 1;
      border: 1px dashed var(--card-border-dashed);
      border-radius: 6px;
      background: var(--surface-faint);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      color: var(--ink-soft);
      opacity: 0.7;
    }

    /* now playing */
    .np-grid {
      display: grid;
      grid-template-columns: 60px 1fr;
      gap: 14px;
      align-items: center;
    }
    .np-art {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: repeating-radial-gradient(circle, #2b2140 0 2px, #fff 2px 8px);
      border: 1px solid rgba(255,255,255,0.8);
      box-shadow: 0 4px 10px rgba(26,18,46,0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      animation: spin 6s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    .np-track {
      font-size: 0.92rem;
      font-weight: 700;
      margin: 0 0 8px;
      color: var(--ink);
    }
    .np-bar {
      height: 8px;
      background: var(--surface);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 10px;
    }
    .np-bar-fill {
      width: 38%;
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--accent-deep));
      animation: bar-fill 12s ease-in-out infinite alternate;
    }
    @keyframes bar-fill {
      from { width: 12%; }
      to { width: 82%; }
    }
    .np-eq {
      display: flex;
      gap: 4px;
      align-items: flex-end;
      height: 18px;
    }
    .np-eq span {
      width: 4px;
      background: var(--accent-teal);
      animation: eq 1.1s ease-in-out infinite;
    }
    .np-eq span:nth-child(1) { height: 40%; animation-delay: 0s; }
    .np-eq span:nth-child(2) { height: 90%; animation-delay: 0.1s; }
    .np-eq span:nth-child(3) { height: 60%; animation-delay: 0.2s; }
    .np-eq span:nth-child(4) { height: 100%; animation-delay: 0.3s; }
    .np-eq span:nth-child(5) { height: 50%; animation-delay: 0.4s; }
    @keyframes eq {
      0%, 100% { transform: scaleY(0.4); }
      50% { transform: scaleY(1); }
    }

    /* buttons + notes */
    .hand-note {
      font-size: 0.85rem;
      color: var(--ink-soft);
      margin: 0 0 14px;
      font-style: italic;
    }
    .portfolio-inline-btn {
      display: inline-block;
      margin-top: 14px;
      font-size: 0.9rem;
    }

    /* nav list (left sidebar) */
    .nav-subheading {
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 0 0 4px;
      font-weight: 700;
      font-size: 0.82rem;
      color: var(--ink);
    }
    .nav-divider {
      margin: 16px 0;
    }
    .nav-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 6px;
    }
    .nav-list a {
      display: block;
      background: var(--surface);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      padding: 8px 10px;
      text-decoration: none;
      color: var(--ink);
      font-weight: 600;
      font-size: 0.82rem;
      transition: background 0.12s ease;
    }
    .nav-list a:hover {
      background: var(--surface-hover);
    }

    /* mini games teaser */
    .games-grid {
      display: grid;
      gap: 8px;
    }
    .game-slot {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--surface-faint);
