---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import WaterButton from '../components/WaterButton.astro';
import BubbleDivider from '../components/BubbleDivider.astro';
import Sticker from '../components/Sticker.astro';

const updates = [
  { date: '09/29', text: 'Music got a new look 🌀 you can now select your music from the new music page! Did I mention that music keeps playing even when you switch pages? (°□°) ა🥬' },
  { date: '09/24', text: 'Blog got its own embedded newsletter! Wanna see what I post? Go subscribe to the newsletter :3' },
  { date: '09/23', text: 'Blog is here! YAAAAAAYYYY! More spending your time!' },
  { date: '09/18', text: 'MsPaint page now has a gallery. Make your drawings, and send them to me so that I upload them!' },
  { date: '09/18', text: 'Commissions page is done and open woohoo :o' },
  { date: '09/17', text: 'New game added: Metal Slug X!' },
  { date: '09/05', text: 'Art gallery is finally open! Go Go Go!!' },
  { date: '08/29', text: 'Guestbook is now availablee wheeee' },
  { date: '08/27', text: 'Added Paint!' },
  { date: '08/26', text: 'We got games! Space Cadet Pinball and Spider Solitaire!!' },
  { date: '08/25', text: 'Chat is now open! Leave your messages theeree' },
  { date: '08/24', text: 'Yooo we got a status noowww' },
  { date: '08/23', text: 'Added music, social media and friends!' },
  { date: '08/22', text: 'Dark mode + layered day/night wallpaper added' },
  { date: '08/21', text: 'Added art banners and maaany art components, will add more overtime teehee' },
  { date: '08/18', text: 'Redesigned into a 3-column desktop layout' },
  { date: '08/17', text: 'Windows Aero glass' },
];

const announcements = [
  'Made a little bit of a revamp: friends list now moooves, the nav bar can be collapsed, plus added a new thinner banner :p',
  'YO blog is finally here! 📰 Fr cant believe it, more posts will come soon!',
  'Site is perpetually a work in progress',
];
---

<Layout>
  <PageShell>
    <!-- ================= single merged content window ================= -->
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="yellow_sunflower.gif" /></span>
        <span class="title-bar-text">gemmies-site.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <!-- ---- about me ---- -->
        <div class="doc-section" id="about">
          <div class="profile-grid">
            <div class="avatar-frame">
              <img class="avatar-img" src="/images/GemmieBust.webp" alt="Gemmie bust illustration" />
            </div>
            <div>
              <h1>Gemmie <span class="sparkle">☆</span></h1>
              <div class="bio-banner">
                <img class="bio-doodle" src="/images/gemmie_doodle.png" alt="" aria-hidden="true" />
                <img class="bio-banner-img" src="/images/banners/banner_bio.png" alt="Female — Cartoon Artist + Animator" />
              </div>
              <p class="blurb">
                <Sticker name="white_penguin.gif" /> Studying Software Engineering in uni.
                <br />
                <Sticker name="blue_shark.gif" /> Fan of many things: my PSVita &amp; 3DS, frutiger aero, cats, Python, sunflowers, art + animation, music and CDs.
              </p>
              <WaterButton
                href="https://code.gemmiewow.com/"
                label="🌍 Visit my Programming Portfolio"
                waterColor="#3fbfc7"
                external
              />
              

              <WaterButton
                href="/art/commissions"
                label="💌 See my commissions here!"
                waterColor="#d472a1"
              />

            </div>
          </div>
        </div>

        <BubbleDivider />

        <!-- ---- site updates + announcements ---- -->
        <div class="doc-section" id="updates">
          <div class="inner-window-grid">
            <div class="update-card">
              <div class="update-card-banner">
                <img src="/images/banners/banner_site_updates.png" alt="Site Updates" />
              </div>
              <div class="update-card-body card-border">
                <div class="update-card-scroll scroll-border">
                  <ul class="update-list">
                    {updates.map((u) => (
                      <li><span class="update-date">{u.date}</span> {u.text}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <div class="update-card">
              <div class="update-card-banner">
                <img src="/images/banners/banner_announcements.png" alt="Announcements" />
              </div>
              <div class="update-card-body card-border">
                <div class="update-card-scroll scroll-border">
                  <ul class="update-list">
                    {announcements.map((a) => (
                      <li><span class="update-bullet" aria-hidden="true">☆</span> {a}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <BubbleDivider />

        <!-- ---- what is this site ---- -->
        <div class="doc-section" id="what-is-this">
          <img class="section-banner" src="/images/banners/banner_what_is_this.png" alt="What is this?" />
          <div class="article-grid">
            <div class="article-portrait">
              <img class="article-portrait-img" src="/images/Gemmie_sit.png" alt="Gemmie sitting illustration" />
            </div>
            <div>
              <p class="blurb">
                <Sticker name="yellow_sunflower.gif" /> Welcome to my website! This is my little personal spot on the internet filled with art and games.
                I keep adding new stuff, so make sure you check the 'Site Updates' above. It's specifically made to be cluttered and clickable, like the old internet.
                <span class="sparkle">☆</span>
              </br>
              </br>
                <Sticker name="blue_teddybear.gif" /> Leave your comments and feedback in my <a href="/guestbook" class="guestbook-link">guestbook</a>! I would love to hear from you! <span class="sparkle">☆</span>
              </br>
              </br>
              <Sticker name="blue_castle.gif" /> If you enjoy the site, consider bookmarking it! Add my button to your own website or we can become affiliates!
              </p>
            </div>
          </div>
        </div>

        <BubbleDivider />

        <!-- ---- shop ---- -->
        <div class="doc-section" id="shop">
          <img class="section-banner" src="/images/banners/banner_shop.png" alt="Click for shop" />
          <a class="shop-link" href="https://ko-fi.com/gemmiewow/" target="_blank" rel="noopener noreferrer">
            <img class="shop-img" src="/images/banners/Gemmie_shop.png" alt="Gemmie's Ko-fi shop" />
          </a>
        </div>
      </div>
    </section>
  </PageShell>
</Layout>
