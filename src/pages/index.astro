                </a>
                <!-- Made by a girl clique -->
                <a href="https://grrrl.valentinely.cc/" target="_blank" rel="noopener" style="display: inline-block; padding: 10px;">
                  <img src="/images/other_components/gemmie_made_by_a_girl.png" alt="Made by a girl clique" loading="lazy" />
                </a>
                <a href="https://stimpop.nekoweb.org/catpals/" target="_blank" rel="noopener" style="display: inline-block;padding: 15px;">
                  <img src="/images/other_components/catpal.png" alt="Cat pal clique!" loading="lazy" />
                </a>
              </div>
            </div>

            <div class="shop-col">
              <h2 class="links-section-heading">🔗 Webrings</h2>
              <p class="hand-note">Webrings I'm part of: see <a href="/links">links page</a></p>

              <div class="webring-scroll-box webring-stack">
                <div class="friends-grid">

                  <!-- webmaster -->
                <map name="badge-wwstamp">
                    <area shape="rect" coords="66,38,79,49" href="https://webmasterwebring.netlify.app?Gemmie-previous" alt="Previous" target="_blank">
                    <area shape="rect" coords="78,29,90,40" href="https://webmasterwebring.netlify.app?Gemmie-next" alt="Next" target="_blank">
                    <area shape="rect" coords="13,15,63,47" href="https://webmasterwebring.netlify.app" alt="Webmaster Webring" target="_blank">
                </map>
                <img usemap="#badge-wwstamp" id="ww-stamp" src="https://file.garden/ZrZSgsrYfQXsO7QH/ww/stamp.png" alt="Webmaster Webring" width="99" height="56">


                  <!-- petrapixel -->
                  <a class="offsite-btn" href="https://petrapixel.neocities.org/indiewebdb/" target="_blank" rel="noopener" aria-label="indie web database">
                    <img src="https://cdn.jsdelivr.net/gh/petracoding/petrapixel.neocities.org@latest/public/assets/img/links/indiewebdb.png" alt="indie web database" loading="lazy" />
                  </a>
                  

                  <!-- angelical -->
                  <a class="offsite-btn" href="https://butteroncookies.neocities.org/angelical" target="_blank" rel="noopener" aria-label="become an angel clique!">
                    <img src="/images/other_components/angelicalbtn.gif" alt="become an angel clique button" loading="lazy" />
                  </a>
                </div>

            
               

                <!--For The Dreamers -->
                <div style="text-align: center;">
                  <a href="https://e0nbreak.neocities.org/miscellaneous/connectcollect" target="_blank"><b>For The Dreamers</b></a><br />
                  <img src="/images/other_components/gemmie_dream_webring.gif" style="width: 200px;">
                  <br />
                  <a href="https://e0nbreak.neocities.org/miscellaneous/connectcollect?action=previous" target="_blank">←</a>
                  <a href="https://e0nbreak.neocities.org/miscellaneous/connectcollect?action=random" target="_blank">Random?</a>
                  <a href="https://e0nbreak.neocities.org/miscellaneous/connectcollect?action=next" target="_blank">→</a>
                </div>

                <!-- Wii Ring -->
                <div style="width: 135px; /* <- Set any width you'd like! */">
                <iframe style="border: none; width: 100%" src="https://wiiring.jeith.com/snippet?site=https://gemmiewow.com/&variant=standard"></iframe>
                </div>
                
                <!--Windows Enthusiasts Webring -->
                <iframe class="webring-iframe" title="Windows Enthusiasts Webring" src="https://brooklynights.nekoweb.org/we_bring/ifridget"></iframe>
							

                <!-- Sanrio Webring -->
                <div class="sanringo cinnamoroll">
                <a class="title" href="https://luckyatoll.nekoweb.org/sanringo.html">Sanrio Webring</a>
                <br>
                <a class="prev" href="https://luckyatoll.nekoweb.org/sanringo.html?action=previous"><img src="https://luckyatoll.nekoweb.org/images/pinkarrow.png"></a>
                <img class="character" src="https://www.sanrio.co.jp/special/characterranking/2020/assets/img/common/character/cinnamon.png">
                <a class="next" href="https://luckyatoll.nekoweb.org/sanringo.html?action=next"><img src="https://luckyatoll.nekoweb.org/images/pinkarrow.png"></a>
                <br>
                <a class="info" href="https://luckyatoll.nekoweb.org/sanringo.html">what's this?</a>
