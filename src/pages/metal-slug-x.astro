---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import Sticker from '../components/Sticker.astro';
import DocBanner from '../components/DocBanner.astro';
---

<Layout title="Metal Slug X ☆ Gemmie's corner">
  <PageShell showMisc={false}>
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="blue_console.gif" /></span>
        <span class="title-bar-text">metal-slug-x.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="metal-slug-x">
          <DocBanner src="/images/banners/banner_metalslugX.png" alt="Metal Slug X" />
          <p class="hand-note">
            Hosted by <a href="=https://www.retrogames.cc/" target="_blank" rel="noopener noreferrer">retrogames.cc</a>
            <br/> Arrow keys to move
            <br/> Z to shoot
            <br/> X to jump
            <br/> S to throw grenades
            <br/> RIGHT SHIFT to insert coin
            <br/> You can change your controls from the game itself if you need to :p
          </p>
          <div class="game-frame game-frame--metalslug">
            <div class="game-frame-scale game-frame-scale--metalslug">
              <iframe
                class="game-frame-iframe game-frame-iframe--metalslug"
                src="https://www.retrogames.cc/embed/9170-metal-slug-x-super-vehicle-001-ngm-2500-ngh-2500.html"
                title="Metal Slug X - Super Vehicle-001"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>
  </PageShell>
</Layout>
