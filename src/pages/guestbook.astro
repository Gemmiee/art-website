---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import Sticker from '../components/Sticker.astro';
import DocBanner from '../components/DocBanner.astro';
---

<Layout title="Guestbook ☆ Gemmie's corner">
  <PageShell showMisc={false}>
    <!-- ================= guestbook window ================= -->
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="blue_teddybear.gif" /></span>
        <span class="title-bar-text">guestbook.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="guestbook">
          <DocBanner src="/images/banners/banner_guestbook.png" alt="Guestbook" />
          <p style="display: flex;" class="hand-note">
            Guestbook hosted by:
            <a style="margin-left:5px;" class="offsite-btn" href="https://atabook.org/" target="_blank" rel="noopener" aria-label="atabook website">
              <img src="https://atabook.org/images/button.gif" alt="atabook website button" loading="lazy" />
            </a>
          </p>

          <iframe src="https://gemmie.atabook.org/"
          class="guestbook-page-iframe"
          loading="lazy"></iframe>

          <!-- OLD GUESTBOOK 
          <iframe
            class="guestbook-page-iframe"
            src="https://users.smartgb.com/g/g.php?a=s&i=g19-03423-df"
            title="Gemmie's Guestbook"
            loading="lazy"
          ></iframe>
          -->

        </div>
      </div>
    </section>
  </PageShell>
</Layout>
