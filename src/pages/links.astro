---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import Sticker from '../components/Sticker.astro';
import BubbleDivider from '../components/BubbleDivider.astro';
import DocBanner from '../components/DocBanner.astro';

---

<Layout title="Links ☆ Gemmie's corner">
  <PageShell showMisc={false}>
    <!-- ================= links window ================= -->
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="black_computer.gif" /></span>
        <span class="title-bar-text">links.exe</span>
        
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="links">
          <DocBanner src="/images/banners/banner_links.png" alt="Links" />
        </div>

        <!-- ---- friends ---- -->
        <div class="doc-section" id="links-friends">
          <h2 class="links-section-heading">💌 Friends</h2>
          <p class="hand-note">My friends aka cool as heck people</p>
          <div class="friends-grid">
            <a class="friend-btn" href="https://www.instagram.com/mage.236" target="_blank" rel="noopener" aria-label="Mage">
              <img src="/images/friends/button_mage.png" width="88" height="31" alt="Mage" />
            </a>
            <a class="friend-btn" href="https://www.instagram.com/athinaleli/" target="_blank" rel="noopener" aria-label="Leli">
              <img src="/images/friends/button_leli.png" width="88" height="31" alt="Leli" />
            </a>
            <a class="friend-btn" href="https://www.youtube.com/channel/UCMr9ZRUKxJgv4uBKAtGeM0w" target="_blank" rel="noopener" aria-label="mianimator">
              <img src="/images/friends/button_mia.gif" width="88" height="31" alt="mianimator" />
            </a>
            <a class="friend-btn" href="https://linktr.ee/sweetlysours" target="_blank" rel="noopener" aria-label="Sweetly">
              <img src="/images/friends/button_sweetly.png" width="88" height="31" alt="Sweetly" />
            </a>
            <a class="friend-btn" href="https://www.instagram.com/kaito_solos_" target="_blank" rel="noopener" aria-label="Leda">
              <img src="/images/friends/button_leda.png" width="88" height="31" alt="Leda" />
            </a>
            <a class="friend-btn" href="https://grasshampoo.carrd.co/" target="_blank" rel="noopener" aria-label="Grassy">
              <img src="/images/friends/button_grassy.png" width="88" height="31" alt="Grassy" />
            </a>
            <a class="friend-btn" href="https://www.instagram.com/voiceofthederanged" target="_blank" rel="noopener" aria-label="Dera">
              <img src="/images/friends/button_dera.gif" width="88" height="31" alt="Dera" />
            </a>
            <a class="friend-btn" href="https://klaxxium.carrd.co/" target="_blank" rel="noopener" aria-label="Klaxxium">
              <img src="/images/friends/button_klax.gif" width="88" height="31" alt="Klaxxium" />
            </a>
          </div>
        </div>

        <BubbleDivider class="bubble-divider-dashed" />

        <!-- ---- webrings ---- -->
        <div class="doc-section" id="links-webrings">
          <h2 class="links-section-heading">🔗 Webrings</h2>
          <p class="hand-note">Webrings I'm part of</p>

          <div class="friends-grid">

            <!--Windows Enthusiasts Webring -->
              <iframe class="webring-iframe" title="Windows Enthusiasts Webring" src="https://brooklynights.nekoweb.org/we_bring/ifridget"></iframe>

              
            <!-- Wii Ring -->
                <div style="width: 135px; /* <- Set any width you'd like! */">
                <iframe style="border: none; width: 100%" src="https://wiiring.jeith.com/snippet?site=https://gemmiewow.com/&variant=standard"></iframe>
                </div>


            <!--For The Dreamers -->
            <div class="doc-section">
              <center>
              <a href="https://e0nbreak.neocities.org/miscellaneous/connectcollect"><b>For The Dreamers</b></a><br />
              <img src="/images/other_components/gemmie_dream_webring.gif" style="width: 200px;">
              </center>
              <center>
              <a href="https://e0nbreak.neocities.org/miscellaneous/connectcollect?action=previous">←</a>
              <a href="https://e0nbreak.neocities.org/miscellaneous/connectcollect?action=random">Random?</a>
              <a href="https://e0nbreak.neocities.org/miscellaneous/connectcollect?action=next">→</a>
              </center>
            </div>

            <!-- Sanrio Webring -->
            <div class="doc-section sanringo cinnamoroll">
              <a class="title" href="https://luckyatoll.nekoweb.org/sanringo.html">Sanrio Webring</a>
              <br>
              <a class="prev" href="https://luckyatoll.nekoweb.org/sanringo.html?action=previous"><img src="https://luckyatoll.nekoweb.org/images/pinkarrow.png"></a>
              <img class="character" src="https://www.sanrio.co.jp/special/characterranking/2020/assets/img/common/character/cinnamon.png">
              <a class="next" href="https://luckyatoll.nekoweb.org/sanringo.html?action=next"><img src="https://luckyatoll.nekoweb.org/images/pinkarrow.png"></a>
              <br>
              <a class="info" href="https://luckyatoll.nekoweb.org/sanringo.html">what's this?</a>
            </div>
          
          
          <!-- WEBRING DIV FINISHES HERE!!! im getting lost -->
          </div>

          <div class="friends-grid">
            <a class="offsite-btn" href="https://petrapixel.neocities.org/indiewebdb/" target="_blank" rel="noopener" aria-label="indie web database">
              <img src="https://cdn.jsdelivr.net/gh/petracoding/petrapixel.neocities.org@latest/public/assets/img/links/indiewebdb.png" alt="indie web database" loading="lazy" />
            </a>

             <!-- angelical -->
                  <a class="offsite-btn" href="https://butteroncookies.neocities.org/angelical" target="_blank" rel="noopener" aria-label="become an angel clique!">
                    <img src="/images/other_components/angelicalbtn.gif" alt="become an angel clique button" loading="lazy" />
                  </a>

             <!-- webmaster -->
                <map name="badge-wwstamp">
                    <area shape="rect" coords="66,38,79,49" href="https://webmasterwebring.netlify.app?Gemmie-previous" alt="Previous" target="_blank">
                    <area shape="rect" coords="78,29,90,40" href="https://webmasterwebring.netlify.app?Gemmie-next" alt="Next" target="_blank">
                    <area shape="rect" coords="13,15,63,47" href="https://webmasterwebring.netlify.app" alt="Webmaster Webring" target="_blank">
                </map>
                <img usemap="#badge-wwstamp" id="ww-stamp" src="https://file.garden/ZrZSgsrYfQXsO7QH/ww/stamp.png" alt="Webmaster Webring" width="99" height="56">


            <!-- Online Widget -->
            <map name="onlinewidget">
            <area href="https://webring.ghostk.id/online/" target="_blank" shape="rect" coords="20,14,167,24" alt="The online webring" title="The online webring">
            <area href="https://webring.ghostk.id/online/Gemmie/previous" target="_top" shape="rect" coords="7,27,60,36" alt="Previous" title="Previous">
            <area href="https://webring.ghostk.id/online/random" target="_top" shape="rect" coords="74,27,126,36" alt="Random" title="Random">
            <area href="https://webring.ghostk.id/online/Gemmie/next" target="_top" shape="rect" coords="139,27,192,36" alt="Next" title="Next">
            </map>
            <img usemap="#onlinewidget" src="https://ghostk.id/i/onlineblue.gif" width="200" height="40" style="width:200px;height:40px;max-width:none;image-rendering:pixelated;" alt="A Windows style dialog box titled 'THE ONLINE WEBRING' with three clickable buttons labeled Previous, Random, and Next" class="offsite-imagemap" />


          </div>
        </div>

        <BubbleDivider class="bubble-divider-dashed" />

        <!-- ---- neighbours/ mentions ---- -->
        <div class="doc-section" id="links-neighbours">
          <h2 class="links-section-heading">🏠 Mentions & Neighbours</h2>
          <p class="hand-note">Pretty sites :D</p>
          <div class="friends-grid">
            <a class="offsite-btn" href="https://zhongvie.neocities.org/" target="_blank" rel="noopener" aria-label="zhongvie button">
              <img src="https://file.garden/Zq0xOX6Iv3i3b1te/Neocities/sylvieButton.gif" alt="zhongvie button" loading="lazy" />
            </a>

            <a class="offsite-btn" href="https://cerealsnail.com/home" target="_blank" rel="noopener" aria-label="cereal snail button">
              <img src="https://cerealsnail.com/images/buttons/people/snailbutton.gif" alt="cereal snail" loading="lazy" />
            </a>

            <a class="offsite-btn" href="https://lazer-bunny.neocities.org/" target="_blank" rel="noopener" aria-label="lazer bunny button">
              <img src="https://lazer-bunny.neocities.org/art_storage/site_buttons/Button_88x31.gif" alt="lazer bunny button" loading="lazy" />
            </a>

            <a class="offsite-btn" href="http://dumbiee.neocities.org/" target="_blank" rel="noopener" aria-label="dumbiee button">
              <img src="https://i.postimg.cc/YS6KLcb4/dumbiee.png" alt="dumbiee @ neocities" loading="lazy" />
            </a>

            <a class="offsite-btn" href="https://mouse.place/" target="_blank" rel="noopener" aria-label="mouse.place button">
              <img src="https://mouse.place/images/sitebutton/button.webp" alt="mouse.place button" loading="lazy" />
            </a>

            <a class="offsite-btn" href="https://the-end-of-science.com/" target="_blank" rel="noopener" aria-label="the end of science button">
              <img src="https://the-end-of-science.com/Images/requie_button.gif" alt="the end of science button" loading="lazy" />
            </a>

            <a class="offsite-btn" href="https://moonsetterindustries.neocities.org/" target="_blank" rel="noopener" aria-label="Moonsetter Industries button">
              <img src="https://moonsetterindustries.neocities.org/Buttons/LoungeButton.png" alt="Moonsetter Industries image" loading="lazy" />
            </a>

            <a class="offsite-btn" href="https://gremghost.neocities.org" target="_blank" rel="noopener" aria-label="gremghost button">
              <img src="https://gremghost.neocities.org/images/buttons/gremghost.png" alt="gremghost" loading="lazy" />
            </a>

            <a class="offsite-btn" href="https://lunabelle.neocities.org/home" target="_blank" rel="noopener" aria-label="Lunabelle button">
              <img src="https://file.garden/ajaF2K-8TDwH7_jo/lunabelle2.gif" alt="Lunabelle image" loading="lazy" />
            </a>

            <a class="offsite-btn" href="https://pinkfreakbrigade.neocities.org/" target="_blank" rel="noopener" aria-label="Pink freak brigade button">
              <img src="https://pinkfreakbrigade.neocities.org/Images/Affiliates/Pink%20Freak%20Brigade%20Button.gif" alt="Pink freak brigade image" loading="lazy" />
            </a>

            <a class="offsite-btn" href="https://yumi-is.online/" target="_blank" rel="noopener" aria-label="Yumi's Room">
              <img src="https://yumi-is.online/Assets/MyWebsiteButton.gif" alt="Yumi's Room" loading="lazy" />
            </a>

          

          </div>
        </div>

        <BubbleDivider class="bubble-divider-dashed" />

        <!-- ---- fun & useful links ---- -->
        <div class="doc-section" id="links-fun">
          <h2 class="links-section-heading">🌐 Links</h2>
          <div class="doc-section" id="shop">
          <div class="shop-grid">


            <!-- resources links -->
            <div class="shop-col">
              <h2 class="links-section-heading">Resources</h2>
              <ul class="link-list">
                <li>
                  <a href="https://delphi.tools/" target="_blank" rel="noopener">🌱 DelphiTools:</a>
                  A wide range of tools for art, writing, web development and more!
                </li>
                <li>
                  <a href="https://atabook.org/" target="_blank" rel="noopener">️🧊 Atabook:</a>
                  Free guestbook for your website.
                </li>
                <li>
                  <a href="https://www.cloudflare.com/" target="_blank" rel="noopener">🍊 Cloudflare:</a>
                  Free website deployment and hosting? Whoa? Using it for my own site :D
                </li>
                <li>
                  <a href="https://hekate2.github.io/buttonmaker/" target="_blank" rel="noopener">⚙️ 88x31 Button Maker:</a>
                  A simple website to make your own 88x31 buttons ;)
                </li>
                <li>
                  <a href="https://urlclean.com/" target="_blank" rel="noopener">🧹 URLClean:</a>
                  Make sure to clean your urls before sharing them to remove tracking.
                </li>
                <li>
                  <a href="https://www.w3schools.com/" target="_blank" rel="noopener">📚 W3Schools:</a>
                  Html, CSS, Javascript cheat sheet.
                </li>
                <li>
                  <a href="https://www.cursors-4u.com/" target="_blank" rel="noopener">🖱️ Cursors-4U:</a>
                  Cursors for your desktop.
                </li>
              </ul>
            </div>


            <!-- fun links -->
            <div class="shop-col">
              <h2 class="links-section-heading">Fun</h2>
              <ul class="link-list">
                <li>
                  <a href="https://plaza.one/" target="_blank" rel="noopener">🫧 Nightwave Plaza:</a>
                  An aesthetic vaporwave radio.
                </li>
                <li>
                  <a href="https://www.toonamiaftermath.com/" target="_blank" rel="noopener">📺 Toonami Aftermath:</a>
                  A website that hosts a lot of old Toonami shows and movies.
                </li>
                <li>
                  <a href="https://wigglypaint.com/" target="_blank" rel="noopener">🧩 Wiggly Paint:</a>
                  Draw your characters and watch them wiiigle.
                </li>
              </ul>
            </div>

            </div>
            </div>
        </div>
      </div>
    </section>
  </PageShell>
</Layout>
