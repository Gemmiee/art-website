---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import Sticker from '../components/Sticker.astro';
import BubbleDivider from '../components/BubbleDivider.astro';
import { friends } from '../data/friends';
import { neighbours } from '../data/neighbours';

// Sites gemmie enjoys or that helped her out along the way — add real
// entries here as { name, href, blurb }
const links: { name: string; href: string; blurb: string }[] = [
  {
    name: '🌱 DelphiTools',
    href: 'https://delphi.tools/',
    blurb: 'A wide range of tools for art, writing, web development and more!',
  },
  {
    name: '️🧊 Chattable',
    href: 'https://iframe.chat/',
    blurb: 'The platform I used to make my chat! Very easy to use and completely free.',
  },
  {
    name: '🍊 Cloudflare',
    href: 'https://www.cloudflare.com/',
    blurb: 'Free website deployment and hosting? Whoa? Using it for my own site :D',
  },
  {
    name: '🫧 Nightwave Plaza',
    href: 'https://plaza.one/',
    blurb: 'An aesthetic vaporwave radio.',
  },
  {
    name: '⚙️ 88x31 Button Maker',
    href: 'https://hekate2.github.io/buttonmaker/',
    blurb: 'A simple website to make your own 88x31 buttons ;)',
  },
  {
    name: '🧹 URLClean',
    href: 'https://urlclean.com/',
    blurb: 'Make sure to clean your urls before sharing them to remove tracking.',
  },
  {
    name: '📺 Toonami Aftermath',
    href: 'https://www.toonamiaftermath.com/',
    blurb: 'A website that hosts a lot of old Toonami shows and movies.',
  },
  {
    name: '📚 W3Schools',
    href: 'https://www.w3schools.com/',
    blurb: 'The absolute html cheat sheet.',
  }
];
---

<Layout title="Links ☆ Gemmie's corner">
  <PageShell showMisc={false}>
    <!-- ================= links window ================= -->
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="black_computer.gif" /></span>
        <span class="title-bar-text">links.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="links">
          <div class="doc-banner">
            <span class="bubble-wrap" style="left: 8%; animation-duration: 3.2s; animation-delay: -0.5s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 26%; animation-duration: 4s; animation-delay: -2s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 46%; animation-duration: 3.5s; animation-delay: -1.2s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 66%; animation-duration: 4.5s; animation-delay: -3s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 84%; animation-duration: 3.8s; animation-delay: -1.8s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <img class="doc-banner-img" src="/images/banners/banner_links.png" alt="Links" />
          </div>
        </div>

        <!-- ---- friends ---- -->
        <div class="doc-section" id="links-friends">
          <h2 class="links-section-heading">💌 Friends</h2>
          <p class="hand-note">My friends aka cool as heck people</p>
          <div class="friends-grid">
            {friends.map((friend) => (
              <a class="friend-btn" href={friend.href} target="_blank" rel="noopener" aria-label={friend.name}>
                <img src={`/images/friends/${friend.button}`} width="88" height="31" alt={friend.name} />
              </a>
            ))}
          </div>
        </div>

        <BubbleDivider />

        <!-- ---- neighbours ---- -->
        <div class="doc-section" id="links-neighbours">
          <h2 class="links-section-heading">🏠 Neighbours</h2>
          <p class="hand-note">Websites that left me in awe :O</p>
          <div class="friends-grid">
            {neighbours.map((neighbour) => (
              <a class="neighbour-btn" href={neighbour.href} target="_blank" rel="noopener" aria-label={neighbour.name}>
                <img src={neighbour.imgSrc} alt={neighbour.name} loading="lazy" />
              </a>
            ))}
          </div>
        </div>

        <BubbleDivider />

        <!-- ---- fun & useful links ---- -->
        <div class="doc-section" id="links-fun">
          <h2 class="links-section-heading">🌐 Fun &amp; Useful Links</h2>
          <p class="hand-note">Fun + useful sites ;] </p>
          <div class="link-grid">
            {links.map((link) => (
              <a class="link-card" href={link.href} target="_blank" rel="noopener">
                <span class="link-card-name">{link.name}</span>
                <span class="link-card-blurb">{link.blurb}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </PageShell>
</Layout>
