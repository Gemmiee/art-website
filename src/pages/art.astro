---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import ArtPanel from '../components/ArtPanel.astro';
import WaterButton from '../components/WaterButton.astro';
import { scanArtGallery } from '../lib/artGallery';
import Sticker from '../components/Sticker.astro';
import DocBanner from '../components/DocBanner.astro';

// Years newest first, then Memes, then anything else (Commissions)
const isYear = (name: string) => /^\d{4}$/.test(name);
const rank = (name: string) => (isYear(name) ? 0 : name.toLowerCase() === 'memes' ? 1 : 2);
const folders = (await scanArtGallery()).sort((a, b) => {
  const byRank = rank(a.name) - rank(b.name);
  if (byRank !== 0) return byRank;
  if (isYear(a.name)) return Number(b.name) - Number(a.name);
  return a.name.localeCompare(b.name);
});
---

<Layout title="Art Gallery ☆ Gemmie's corner" description="A gallery of my digital and traditional art from 2019 to present.">
  <PageShell showMisc={false}>
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="blue_cinnamonroll.gif" /></span>
        <span class="title-bar-text">gemmies-art.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="art">
          <DocBanner src="/images/banners/banner_art.png" alt="My Art Gallery" />

          <div class="art-tabs" role="tablist" aria-label="Art by year">
            {folders.map((folder, i) => (
              <button
                class="art-tab"
                type="button"
                role="tab"
                id={`art-tab-${folder.id}`}
                aria-controls={`art-panel-${folder.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-folder-id={folder.id}
              >
                {folder.name}
              </button>
            ))}
          </div>

          <div class="art-panels">
            {folders.map((folder, i) => (
              <ArtPanel folder={folder} active={i === 0} widgetViewer={folder.id === 'memes'} />
            ))}
          </div>

          <p class="blurb">
            🌱₊ ⊹ I use IbisPaintX and my finger to draw! Here you'll see some of my digital
            and traditional art. Enjoy and thanks 
            for stopping by! (❁´◡`❁)ﾉ
          </p>

          <center>
          <WaterButton
            href="/art/commissions"
            label="💌 Interested in a commission? See my info + examples here!"
            waterColor="#A32910"
          />
          </center>

          <!-- NEONET Arts Collective webring -->
          <p class="hand-note" style="text-align: center;"> Teehee, I'm Part of the NEONET Arts Collective webring!</p>
          <div class="offsite-btn" id="dumri-art" style="width: fit-content; margin: 0 auto;">
            <script type="text/javascript" src="https://dumbiee.neocities.org/webring/art/variables.js"></script>
            <script type="text/javascript" src="https://dumbiee.neocities.org/webring/art/widget3sfw.js"></script>
          </div>

          <img  src="/images/other_components/gemmies.webp" alt="My Art Gallery" />
        </div>
      </div>
    </section>

    <!-- lightbox -->
    <div class="art-lightbox" id="art-lightbox" hidden>
      <div class="art-lightbox-backdrop" data-close></div>
      <div class="art-lightbox-frame window">
        <div class="title-bar">
          <span class="title-bar-icon" aria-hidden="true">🖼️</span>
          <span class="title-bar-text" id="art-lightbox-title"></span>
          <div class="title-bar-controls" aria-hidden="true">
            <span class="tb-btn close" data-close>×</span>
          </div>
        </div>
        <p class="blurb"> Use the <b>Arrow Keys</b> to navigate easily!</p>
        <div class="art-lightbox-body" id="art-lightbox-body"></div>
        <button class="art-lightbox-nav art-lightbox-prev" type="button" id="art-lightbox-prev" aria-label="Previous image">‹</button>
        <button class="art-lightbox-nav art-lightbox-next" type="button" id="art-lightbox-next" aria-label="Next image">›</button>
      </div>
    </div>
  </PageShell>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    // widgetstar viewer (trial on Memes). Its script crashes if it runs twice, so only load it once
    if (document.querySelector('ws-widget') && !customElements.get('ws-widget') && !document.getElementById('ws-loader')) {
      const loader = document.createElement('script');
      loader.id = 'ws-loader';
      loader.src = 'https://u.widget.st/ar.js';
      document.head.appendChild(loader);
    }

    // ---- year/category tabs ----
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.art-tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.art-panel'));

    const selectTab = (id: string, { focus = false } = {}) => {
      const tab = tabs.find((t) => t.dataset.folderId === id);
      if (!tab) return;
      tabs.forEach((t) => {
        const selected = t === tab;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.folderId !== id;
        if (panel.hidden) return;
        panel.querySelectorAll<HTMLVideoElement>('video[data-src]').forEach((video) => {
          video.src = video.dataset.src!;
          video.removeAttribute('data-src');
        });
      });
      if (focus) tab.focus();
      // keep the pick in the URL so /art#2024 links straight to a year
      history.replaceState(history.state, '', `#${id}`);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectTab(tab.dataset.folderId!));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        selectTab(next.dataset.folderId!, { focus: true });
      });
    });

    const fromHash = decodeURIComponent(location.hash.slice(1));
    if (fromHash && tabs.some((t) => t.dataset.folderId === fromHash)) {
      selectTab(fromHash);
    } else if (tabs[0]) {
      // first tab is already shown, just load its videos
      panels[0]?.querySelectorAll<HTMLVideoElement>('video[data-src]').forEach((video) => {
        video.src = video.dataset.src!;
        video.removeAttribute('data-src');
      });
    }



    document.querySelectorAll<HTMLElement>('.art-gallery').forEach((gallery) => {
      const pages = gallery.querySelectorAll<HTMLElement>('.art-gallery-page');
      gallery.querySelectorAll<HTMLButtonElement>('.art-pager-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = Number(btn.dataset.pageIndex);
          pages.forEach((page, i) => {
            page.hidden = i !== target;
          });
          gallery.querySelectorAll<HTMLButtonElement>('.art-pager-btn').forEach((b) => {
            b.setAttribute('aria-current', b === btn ? 'page' : 'false');
          });
        });
      });
    });

    // ---- lightbox ----
    const lightbox = document.getElementById('art-lightbox');
    const lightboxBody = document.getElementById('art-lightbox-body');
    const lightboxTitle = document.getElementById('art-lightbox-title');
    const prevBtn = document.getElementById('art-lightbox-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('art-lightbox-next') as HTMLButtonElement | null;
    if (lightbox && lightboxBody && lightboxTitle && prevBtn && nextBtn) {
      let currentThumbs: HTMLButtonElement[] = [];
      let currentIndex = -1;

      const renderCurrent = () => {
        const thumb = currentThumbs[currentIndex];
        if (!thumb) return;
        const { full, kind, name } = thumb.dataset;
        lightboxTitle.textContent = name || '';
        lightboxBody.innerHTML =
          kind === 'video'
            ? `<video src="${full}" controls autoplay playsinline></video>`
            : `<img src="${full}" alt="${name || ''}" />`;
      };

      const step = (delta: number) => {
        if (currentThumbs.length === 0) return;
        currentIndex = (currentIndex + delta + currentThumbs.length) % currentThumbs.length;
        renderCurrent();
      };

      const closeLightbox = () => {
        lightbox.hidden = true;
        lightboxBody.innerHTML = '';
        currentThumbs = [];
        currentIndex = -1;
      };

      document.querySelectorAll<HTMLButtonElement>('.art-thumb').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const gallery = thumb.closest('.art-gallery');
          currentThumbs = gallery
            ? Array.from(gallery.querySelectorAll<HTMLButtonElement>('.art-thumb'))
            : [thumb];
          currentIndex = currentThumbs.indexOf(thumb);
          renderCurrent();
          lightbox.hidden = false;
          const hasMultiple = currentThumbs.length > 1;
          prevBtn.hidden = !hasMultiple;
          nextBtn.hidden = !hasMultiple;
        });
      });

      prevBtn.addEventListener('click', () => step(-1));
      nextBtn.addEventListener('click', () => step(1));

      lightbox.querySelectorAll<HTMLElement>('[data-close]').forEach((el) => {
        el.addEventListener('click', closeLightbox);
      });
      document.addEventListener('keydown', (e) => {
        if (lightbox.hidden) return;
        if (e.key === 'Escape') closeLightbox();
        else if (e.key === 'ArrowLeft') step(-1);
        else if (e.key === 'ArrowRight') step(1);
      });
    }
  });
</script>
