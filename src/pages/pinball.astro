---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import Sticker from '../components/Sticker.astro';
import DocBanner from '../components/DocBanner.astro';
---

<Layout title="Space Cadet Pinball ☆ Gemmie's corner">
  <PageShell showMisc={false}>
    <!-- ================= pinball window ================= -->
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="yellow_bee.gif" /></span>
        <span class="title-bar-text">space-cadet-pinball.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="pinball">
          <DocBanner src="/images/banners/banner_pinball.png" alt="Pinball" />
          <p class="hand-note">
            Z and / to flip
          </br> SPACE to launch
        </br> X and . to tilt
        </br> If the buttons don't work, click the game window's X button
          </p>
          <div class="game-frame game-frame--pinball">
            <div class="game-frame-scale">
              <iframe
                class="game-frame-iframe"
                src="https://pinball.alula.me"
                title="3D Pinball for Windows - Space Cadet"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>
  </PageShell>
</Layout>
