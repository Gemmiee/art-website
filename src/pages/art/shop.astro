---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import PageShell from '../../components/PageShell.astro';
import { getImageThumb } from '../../lib/imageThumb';
import Sticker from '../../components/Sticker.astro';
import DocBanner from '../../components/DocBanner.astro';
import { shopProducts, KOFI_SHOP_URL } from '../../data/shopProducts';

const IMAGE_EXTS = new Set(['.png', '.jpg', '.jpeg', '.gif', '.webp']);
const shopDir = path.join(process.cwd(), 'public', 'images', 'shop');
const THUMB_WIDTH = 500;

const shopFiles = fs.existsSync(shopDir)
  ? fs.readdirSync(shopDir, { withFileTypes: true }).filter((entry) => entry.isFile())
  : [];

async function loadImages(id: string) {
  const matches = shopFiles
    .map((entry) => {
      const ext = path.extname(entry.name).toLowerCase();
      if (!IMAGE_EXTS.has(ext)) return null;
      const base = entry.name.slice(0, -ext.length);
      const match = base.match(new RegExp(`^${id}(\\d*)$`, 'i'));
      if (!match) return null;
      const order = match[1] ? parseInt(match[1], 10) : 1;
      return { order, name: entry.name };
    })
    .filter((v): v is { order: number; name: string } => v !== null)
    .sort((a, b) => a.order - b.order);

  return Promise.all(
    matches.map(async ({ name }) => {
      const absPath = path.join(shopDir, name);
      const url = `/images/shop/${encodeURIComponent(name)}`;
      return {
        url,
        thumbUrl: (await getImageThumb(absPath, THUMB_WIDTH)) ?? url,
      };
    })
  );
}

const products = await Promise.all(
  shopProducts.map(async (product) => ({
    ...product,
    images: await loadImages(product.id),
  }))
);
---

<Layout title="Shop ☆ Gemmie's corner" description="Physical art prints and canvases available in my Ko-fi shop.">
  <PageShell showMisc={false}>
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true"><Sticker name="yellow_money.gif" /></span>
        <span class="title-bar-text">gemmies-shop.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="shop">
          <DocBanner src="/images/banners/banner_kofi.png" alt="Shop" />

          <p class="hand-note">
            🎨 Physical canvases I've made! All items ship out from my Ko-fi shop!
          </p>

          <div class="shop-product-list">
            {products.map((product) => (
              <div class="shop-product-card">
                <div class="shop-product-gallery">
                  <div class="shop-carousel">
                    <div class="shop-carousel-track">
                      {product.images.map((img, i) => (
                        <button
                          class:list={['shop-carousel-slide', { 'is-active': i === 0 }]}
                          type="button"
                          tabindex={i === 0 ? 0 : -1}
                          aria-label={`View ${product.title} photo ${i + 1}`}
                        >
                          <img src={img.thumbUrl} data-original={img.url} alt={product.title} loading="lazy" />
                        </button>
                      ))}
                    </div>
                    {product.images.length > 1 && (
                      <>
                        <button class="shop-carousel-nav shop-carousel-prev" type="button" aria-label="Previous image" data-carousel-prev>‹</button>
                        <button class="shop-carousel-nav shop-carousel-next" type="button" aria-label="Next image" data-carousel-next>›</button>
                        <div class="shop-carousel-dots">
                          {product.images.map((_, i) => (
                            <span class:list={['shop-carousel-dot', { 'is-active': i === 0 }]}></span>
                          ))}
                        </div>
                      </>
                    )}
                  </div>
                </div>
                <div class="shop-product-info">
                  <h2 class="shop-product-title">{product.title}</h2>
                  <p class="shop-product-price">{product.price}</p>
                  <p class="shop-product-summary">{product.summary}</p>
                  {product.bullets.length > 0 && (
                    <ul class="shop-product-bullets">
                      {product.bullets.map((line) => <li>{line}</li>)}
                    </ul>
                  )}
                  {product.note && (
                    <div class="shop-product-note">
                      <p class="shop-product-note-heading">» {product.note.heading} «</p>
                      <ul class="shop-product-bullets">
                        {product.note.bullets.map((line) => <li>{line}</li>)}
                      </ul>
                    </div>
                  )}
                  <a class="shop-kofi-btn" href={KOFI_SHOP_URL} target="_blank" rel="noopener noreferrer">
                    Get this from my Ko-fi shop ↗
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

  </PageShell>
</Layout>

<script>
  import { attachViewer } from '../../lib/imageViewer';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.shop-carousel').forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('.shop-carousel-track');
      if (!track) return;
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.shop-carousel-slide'));
      const dots = Array.from(carousel.querySelectorAll<HTMLElement>('.shop-carousel-dot'));
      let index = 0;
      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.classList.toggle('is-active', i === index);
          slide.tabIndex = i === index ? 0 : -1; // hidden slides shouldn't be tabbable
        });
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      };
      carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => show(index - 1));
      carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => show(index + 1));

      // clicking the visible photo opens the lightbox on it; arrows there go through this product's photos
      attachViewer(track, '.shop-carousel-slide');
      // keep the carousel on whatever photo the lightbox was last showing
      track.addEventListener('viewed', (e) => show((e as CustomEvent<{ index: number }>).detail.index));
    });
  });
</script>
