---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import { musicAlbums, bandcampBrowseSrc } from '../data/musicAlbums';
---

<Layout title="Music ☆ Gemmie's corner" description="Albums I love — pick one and it follows you around the site in the sidebar player.">
  <PageShell showMisc={false}>
    <!-- ================= music window ================= -->
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true">♫</span>
        <span class="title-bar-text">gemmies-music.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="music">
          <div class="doc-banner">
            <span class="bubble-wrap" style="left: 8%; animation-duration: 3.2s; animation-delay: -0.5s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 26%; animation-duration: 4s; animation-delay: -2s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 46%; animation-duration: 3.5s; animation-delay: -1.2s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 66%; animation-duration: 4.5s; animation-delay: -3s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <span class="bubble-wrap" style="left: 84%; animation-duration: 3.8s; animation-delay: -1.8s;"><img class="bubble-icon" src="/images/bubble.png" alt="" /></span>
            <img class="doc-banner-img" src="/images/banners/banner_music.png" alt="Music" />
          </div>

          <p class="hand-note">
            🎧 Albums I like! <strong>Press "Play in sidebar"</strong> on one and it'll keep playing
            in the nowplaying.mp3 widget as you browse the rest of the site.
          </p>

          <div class="music-album-list">
            {musicAlbums.map((album) => (
              <div class="music-album-card">
                <div class="music-album-info">
                  <h2 class="music-album-title">{album.title}</h2>
                  <p class="music-album-artist">by {album.artist}</p>
                  <div class="music-album-actions">
                    <button
                      class="music-play-btn"
                      type="button"
                      data-id={album.id}
                      data-title={album.title}
                      data-artist={album.artist}
                      data-cover-url={album.coverUrl}
                    >
                      ▶ Play in sidebar
                    </button>
                    <a class="music-bandcamp-link" href={album.albumUrl} target="_blank" rel="noopener noreferrer">Listen on Bandcamp ↗</a>
                  </div>
                </div>
                <iframe
                  class="music-album-frame"
                  title={`${album.title} by ${album.artist} — Bandcamp player`}
                  src={bandcampBrowseSrc(album.id)}
                  seamless
                  loading="lazy"
                >
                </iframe>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </PageShell>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const activeLabel = '♫ Playing in sidebar';
    const defaultLabel = '▶ Play in sidebar';

    // Reflect whatever's already playing (from an earlier visit or another
    // page) rather than always showing every button as "not yet pressed".
    let currentId = (window as any).__gemmieCurrentAlbumId;
    if (!currentId) {
      try {
        currentId = localStorage.getItem('gemmie-now-playing-album');
      } catch {}
    }
    document.querySelectorAll<HTMLButtonElement>('.music-play-btn').forEach((btn) => {
      const isActive = btn.dataset.id === currentId;
      btn.textContent = isActive ? activeLabel : defaultLabel;
      btn.classList.toggle('is-active', isActive);
    });

    document.querySelectorAll<HTMLButtonElement>('.music-play-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(
          new CustomEvent('gemmie:play-album', {
            detail: {
              id: btn.dataset.id,
              title: btn.dataset.title,
              artist: btn.dataset.artist,
              coverUrl: btn.dataset.coverUrl,
            },
          })
        );

        document.querySelectorAll<HTMLButtonElement>('.music-play-btn').forEach((b) => {
          b.textContent = defaultLabel;
          b.classList.remove('is-active');
        });
        btn.textContent = activeLabel;
        btn.classList.add('is-active');
      });
    });
  });
</script>
