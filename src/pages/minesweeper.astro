---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import DocBanner from '../components/DocBanner.astro';
---

<Layout title="Minesweeper ☆ Gemmie's corner">
  <PageShell showMisc={false}>
    <section class="window main-doc">
      <div class="title-bar">
        <span class="title-bar-icon" aria-hidden="true">💣</span>
        <span class="title-bar-text">minesweeper.exe</span>
        <div class="title-bar-controls" aria-hidden="true">
          <span class="tb-btn">_</span>
          <span class="tb-btn">□</span>
          <span class="tb-btn close">×</span>
        </div>
      </div>
      <div class="window-body">
        <div class="doc-section" id="minesweeper">
          <DocBanner src="/images/banners/banner_minesweeper.png" alt="Minesweeper" />
          <p class="hand-note">
            Click to reveal, right click to flag. I like this one a lot ;p
          </p>
          <div class="game-frame game-frame--minesweeper">
            <div class="game-frame-scale game-frame-scale--minesweeper">
              <iframe
                class="game-frame-iframe game-frame-iframe--minesweeper"
                src="https://mines.vercel.app/"
                title="Minesweeper"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>
  </PageShell>
</Layout>
